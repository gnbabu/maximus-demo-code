                                        <%--<asp:Button ID="btnEmail" runat="server" CssClass="btn btn-primary btn-md" OnClick="btnEmail_Click" Text="Email" />--%>
                                        <asp:Button ID="btnNotes" runat="server" CssClass="btn btn-notes btn-md" OnClick="btnNotes_Click" Text="Notes" />
                                        <a class="btn btn-primary btn-md" data-toggle="collapse" data-target="#collapsible" onclick="javascript:toggle(this);">More ...</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">

                            <asp:UpdatePanel ID="upPnlErrors" runat="server" Visible="false">
                                <ContentTemplate>
                                    <%-- <span class="pageHeader">&nbsp;&nbsp;&nbsp;Screen Errors</span><br />
                            <div class="WhiteBox" id="DivErrors" runat="server" style="padding: 5px 5px 5px 40px !important;">--%>

                                    <asp:Panel ID="pnlReturnReasons" runat="server" class="pnlSummary" ScrollBars="Auto" Visible="false">
                                        <b>Return Reasons</b><br />
                                    </asp:Panel>
                                    <asp:Panel ID="pnlAdverseActions" runat="server" class="pnlSummary" EnableViewState="true" ScrollBars="Auto" Visible="false">
                                        <b>Adverse Actions</b><br />
                                        <asp:Label ID="lblAdverseActions" runat="server" CssClass="failureNotification" EnableViewState="true" Width="100%" Height="65"></asp:Label>
                                    </asp:Panel>
                                    <%-- </div>--%>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                        </div>
                        <div class="row">
                            <asp:UpdatePanel ID="UpdatePanel1" runat="server">
                                <Triggers>
                                    <asp:PostBackTrigger ControlID="ucRegProgressBar" />
                                </Triggers>
                                <ContentTemplate>
                                    <div id="DivProgressBar" runat="server">
                                        <uc4:regprogressbar id="ucRegProgressBar" runat="server" />
                                    </div>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                        </div>
                        <div class="row">
                            <asp:Panel ID="pnlUpdateMessage" runat="server" CssClass="UserHeader" Visible="false">
                                <asp:Label ID="lblUpdateMessage" Visible="false" runat="server" CssClass="failureNotification" Text="Please verify that your contact information including email address are up to date on the Primary Contact Information and Primary Service Address screens before submitting your update. We will use this information to notify you of expiring licenses or re-enrollment dates as well as any new information impacting your DC Medicaid eligibility."></asp:Label>
                            </asp:Panel>
                            <asp:Panel ID="pnlWorkflow1" runat="server" Visible="true">

                                <div class="row">

                                    <div class="col-sm-12 text-right">
                                        <div id="pnlbackToSummary" runat="server" visible="false">
                                          <asp:Button ID="btnbackToSummary" runat="server" Text="Return to Summary" CssClass="buttonBoxFocus"
                                                OnClientClick="if (!CheckIfChangesHappend()) { return false;};" CausesValidation="false" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12 text-right">
                                        <div id="divReturnToGroup" runat="server" visible="false">
                                            <asp:Button ID="btnRtnGroup" runat="server" Text="Return to Group" CssClass="buttonBoxFocus" OnClick="btnRtnGroup_Click"
                                                CausesValidation="true" /><br />
                                        </div>

                                    </div>
                                    <div class="col-sm-12 text-right">
                                        <asp:Panel ID="pnlGeneratePDF" runat="server" Visible="false">
                                            <%--add section for generate pdf --%>
                                            <asp:Button ID="btnGeneratePDF" runat="server" CausesValidation="false" Text="Generate PDF" CssClass="buttonBox" OnClick="btnGeneratePDF_Click" />

                                        </asp:Panel>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12 text-right">
                                        <asp:Panel ID="pnlWorkFlow" runat="server">
                                            <asp:Repeater ID="rptWorkflowActions" runat="server" OnItemDataBound="rptWorkflowActions_ItemDataBound">
                                                <ItemTemplate>
                                                    <!--tdBtnAction style moved to default.css -->
                                                    <td id="tdBtnAction" style="" class="pull-right">
                                                        <asp:Button ID="btnAction" runat="server" CssClass="buttonBoxFocus"
                                                            CommandArgument='<%# DataBinder.Eval(Container.DataItem, "NEXT_TASK_ID") %>'
                                                            Text='<%# DataBinder.Eval(Container.DataItem, "ACTION_NAME") %>' OnClick="btnAction_Click" /></td>
                                                </ItemTemplate>
                                            </asp:Repeater>
                                        </asp:Panel>
                                    </div>
                                </div>

                            </asp:Panel>
                        </div>
                        <div class="row">
                            <asp:UpdatePanel ID="upLoading" runat="server" UpdateMode="Conditional">
                                <ContentTemplate>

                                    <asp:UpdateProgress runat="server" ID="upProgress" DisplayAfter="0">
                                        <ProgressTemplate>
                                            <div class="loading">
                                                <asp:Image ID="imgLoading" runat="server" AlternateText="loading" ImageUrl="~/Images/ajax-loader.gif" />Loading...
                                            </div>
                                        </ProgressTemplate>
                                    </asp:UpdateProgress>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                        </div>
                        <div class="row">
                            <asp:Panel ID="pnlRightBox" runat="server">
                                <asp:Panel ID="pnlPageHeader" runat="server">
                                    <center>
                                        <asp:ContentPlaceHolder id="PageLabelContent" runat="server">
                                        </asp:ContentPlaceHolder>
                                    </center>
                                </asp:Panel>


                                <asp:ValidationSummary ID="vsProviderInfoHeader" runat="server" DisplayMode="List" ValidationGroup="valProviderInfoHeader"
                                    Style="max-height: 120px; overflow-y: auto;" CssClass="failureNotification" />

                                <%-- <asp:Panel ID="pnlPageMainContent" CssClass="WhiteBoxNoTopBorder" runat="server">--%>
                                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                                <%--  </asp:Panel>--%>
                            </asp:Panel>

                        </div>
                    </div>
                </div>
            </div>
            <div id="Footer">
                <!-- Opens the Footer DIV -->
                <div id="footerContent">
                    <div>
                        <asp:Label ID="lblVersion" CssClass="fieldLabel" EnableViewState="false" runat="server" />
                    </div>
                    <br />
                    <div>
                        <div class="row">
                            <div class="col-sm-2"></div>
                            <div class="col-sm-4 center">
                                <span>ODM Provider Enrollment and Assistance</span><br />
                                <span>1-800-686-1516</span>
                            </div>
                            <div class="col-sm-4 center">
                                <strong>Mailing Address:</strong>
                                Ohio Department of Medicaid<br />
                                Provider Enrollment Unit<br />
                                P.O. Box 1461<br />
                                Columbus, OH 43216-1461
                            </div>
                            <div class="col-sm-2"></div>
                        </div>
                    </div>
                    <br />

                    <a href="https://medicaid.ohio.gov/">Home</a> -
                    <asp:HyperLink ID="lnkContactUs" runat="server" NavigateUrl="~/Process/ContactUs.aspx" Text="Contact Us" />
                    - <a href="https://ohio.gov/wps/portal/gov/site/home/privacy-notice-and-policies" target="_blank">Security, Privacy &amp; Accessibility Policy</a> - <a href="https://medicaid.ohio.gov/Terms">Terms of Usage Policy</a>

                </div>
                <!-- Closes the ContactInfo DIV -->
            </div>
            <!-- Closes the Footer DIV -->


            <!-- ModalPopupExtender -->
            <style type="text/css">
                .navigationModalBackground {
                    background-color: Gray;
                    filter: alpha(opacity=70);
                    opacity: 0.2;
                    height: auto;
                }

                .navigationModalPopup {
                    background-color: #FFFFFF;
                    border-width: 1px;
                    border-style: solid;
                    border-color: black;
                    padding: 0px;
                    width: auto;
                    height: auto;
                }
            </style>
            
            <cc1:modalpopupextender id="modalCMCSucess" runat="server"
                popupcontrolid="pnlPopup" targetcontrolid="btnCMCdummy" backgroundcssclass="modalBackground">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlPopup" runat="server" CssClass="modalPopup" Style="display: none; padding: 20px; width: 50%;">
                <div class="center">
                    Your application for the CMC program has been submitted.
        <br />
                    You will receive a Welcome letter upon approval
                </div>
                <div class="center">
                    <asp:Button runat="server" ID="btnHide" Text="OK" CssClass="buttonBox" OnClick="btnHide_Click" />
                </div>
            </asp:Panel>
            <asp:Button runat="server" ID="btnCMCdummy" Style="display: none" Text="ButtonDummy" />

            <!-- ModalPopupExtender -->
            <cc1:modalpopupextender id="mpeSaveDisEnrollement" runat="server" targetcontrolid="ButtonDummy" popupcontrolid="pnlSaveDisEnrollement" backgroundcssclass="modalBackground" popupdraghandlecontrolid="pnlSaveDisEnrollement">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlSaveDisEnrollement" runat="server" CssClass="modalPopup" Style="display: none; width: 800px;">
                <asp:Panel ID="pnlDisenrollment" runat="server" Style="height: auto; width: auto;">
                    <asp:Panel ID="pnlDisenrollHdr" CssClass="popHeader" runat="server">
                        <asp:Label ID="lblpopTitle" runat="server" CssClass="popTitle">Provider Disenrollment</asp:Label>
                    </asp:Panel>
                    <viewdisenroll:disenrollmentview id="ucDisenrollmentView" runat="server" />
                </asp:Panel>

            </asp:Panel>

            <cc1:modalpopupextender id="mpe1" runat="server" popupcontrolid="pnlModal1" targetcontrolid="ButtonDummy"
                backgroundcssclass="navigationModalBackground" popupdraghandlecontrolid="pnlHeader1" cancelcontrolid="btnCancelmpe1">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlModal1" runat="server" CssClass="navigationModalPopup" align="center" Style="display: none; min-height: 250px; min-width: 610px; height: auto; width: auto;">
                <asp:Panel ID="pnlHeader1" CssClass="pnlHeader" runat="server" HorizontalAlign="Left">
                    <div align="center">
                        &nbsp;&nbsp;
            <asp:Label ID="lblMpeTitle1" CssClass="bodyTextBold" runat="server" Text="Title" ForeColor="White" />
                    </div>
                </asp:Panel>
                <asp:Panel ID="pnlMain1" runat="server" Style="margin-right: 10px" DefaultButton="btnSaveApproveProvider">
                    <asp:MultiView ID="mltPopup" runat="server">

                        <asp:View ID="vwApproveProvider" runat="server">
                            <cc2:approveprovider id="ucApproveProvider" runat="server" />
                        </asp:View>

                        <asp:View ID="vwReturnToScreening" runat="server">
                            <cc4:returntoscreening id="ucReturnToScreening" runat="server" />
                        </asp:View>

                        <asp:View ID="vwProviderRiskLevel" runat="server">
                            <cc5:providerrisklevel id="ucProviderRiskLevel" runat="server" />
                        </asp:View>

                        <asp:View ID="vwLTProviderEnrollment" runat="server">
                            <cc6:ltproviderenrollment id="ucLTProviderEnrollment" runat="server" />
                        </asp:View>

                        <asp:View ID="vwCredentialRTP" runat="server">
                            <cc7:credentialrtp id="ucCredentialRTP" runat="server" />
                        </asp:View>

                         <asp:View ID="vwNotProcessed" runat="server">
                            <div class="row">
                                <asp:ValidationSummary ID="ValNotProcessed" runat="server" DisplayMode="List" ValidationGroup="ValNotProcessed" CssClass="failureNotification val-summary" />
                            </div>
                            <div class="row ">
                                <div class="col-sm-3 text-right" style="padding-right: 0px;"><span>Comments:*</span></div>
                                <div class="col-sm-9 text-left">
                                    <asp:TextBox ID="txtNotProcessedComments" runat="server" aria-label="Notes to Provider" MaxLength="1000" CssClass="modalFormField" ValidationGroup="ValNotProcessed" TextMode="MultiLine" Columns="100" Rows="7" />
                                        <asp:RequiredFieldValidator ID="valCommentRequired" runat="server" ControlToValidate="txtNotProcessedComments"
                                    ErrorMessage="* Comments are required." Display="Dynamic" Text="*"
                                    ValidationGroup="ValNotProcessed" />
                                </div>  
                            </div>
                        </asp:View>

                        <asp:View ID="vwReferToComplianceReasons" runat="server">
                            <cc8:ReferToComplianceReasons id="ucComplReason" runat="server" />
                        </asp:View>
                    </asp:MultiView>
                   
                    <div class="row">

                        <div class="col-sm-12 text-center">
                            <asp:Button ID="btnSaveApproveProvider" runat="server" Text="Save" CssClass="buttonBoxFocus" OnClick="btnSaveApproveProvider_Click"
                                CausesValidation="true" ValidationGroup="ValNotProcessed"/>

                            <asp:Button ID="btnCancelmpe1" runat="server" Text="Cancel" CssClass="buttonBox"
                                CausesValidation="false" />

                        </div>
                    </div>
                </asp:Panel>

                <br />
            </asp:Panel>
            <asp:Button runat="server" ID="ButtonDummy" Style="display: none" Text="ButtonDummy" />

            <cc1:modalpopupextender id="mpeUpdateChanges" runat="server" popupcontrolid="pnlUpdateChanges" targetcontrolid="btnUpdateDummy"
                backgroundcssclass="modalBackground" popupdraghandlecontrolid="pnlUpdateChanges" cancelcontrolid="btnCancelUpdate">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlUpdateChanges" runat="server" CssClass="modalPopup" Style="display: none; padding: 20px; width: 620px;">
                <div id="divUpdateSections" runat="server" class="center">
                    You have modified the following sections in your application. Click "Ok" to complete your submission. Click "Cancel" to review your application prior to submission.
        <br />
                    <br />

                </div>
                <div class="btnBox">
                    <asp:Button runat="server" ID="btnUpdateOk" Text="OK" CssClass="buttonBoxFocus" CausesValidation="true" OnClick="btnUpdateOk_Click" />
                    <asp:Button runat="server" ID="btnCancelUpdate" Text="Cancel" CssClass="buttonBox" CausesValidation="false" />
                </div>
            </asp:Panel>
            <asp:Button runat="server" ID="btnUpdateDummy" Style="display: none" Text="UpdateDummy" />

            <cc1:modalpopupextender id="mpeNotesGrid" runat="server" targetcontrolid="btnNotesDummy" popupcontrolid="pnlModalNotes"
                cancelcontrolid="btnCancelNotes" backgroundcssclass="modalBackground" behaviorid="bhmpeNotesGrid">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlModalNotes" runat="server" CssClass="modalPopup" align="center" Style="display: none; width: 70%; height: auto;">
                <asp:Panel ID="pnlHeader" CssClass="pnlHeader" runat="server" HorizontalAlign="Left">
                    <div class="popTitle">
                        <h2>Notes</h2>
                    </div>
                </asp:Panel>
                <asp:Panel ID="pnlMainNotes" runat="server" Style="margin-right: 10px" DefaultButton="btnCancelNotes">
                    <uc6:notes id="ucNotes" runat="server" mode="Grid" />
                </asp:Panel>
                <div class="row btnBox">
                    <asp:Button ID="btnCancelNotes" runat="server" Text="Close" CssClass="buttonBox" CausesValidation="false" />
                </div>
            </asp:Panel>


            <asp:Button runat="server" ID="btnNotesDummy" aria-Label="dummybutton" Style="display: none" />
            <cc1:modalpopupextender id="mpeEmailsGrid" runat="server" popupcontrolid="pnlModalEmails" targetcontrolid="btnEmailDummy"
                cancelcontrolid="btnClose" backgroundcssclass="modalBackground">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlModalEmails" runat="server" CssClass="modalPopup" align="center" Style="display: none; width: 70%; height: auto;">
                <asp:Panel ID="Panel3" CssClass="popHeader" runat="server">
                    <div class="popTitle">Email Notifications</div>
                </asp:Panel>
                <asp:Panel ID="Panel1" runat="server" Style="margin-right: 10px" DefaultButton="btnCancelNotes">
                    <div id="divTest1" runat="server" style="max-height: 700px; overflow-y: scroll;">
                        <uc7:emails id="ucEmails" runat="server" mode="Grid" />
                    </div>
                </asp:Panel>
                <div class="row btnBox" style="padding-bottom: 10px; margin-left: auto; margin-right: auto;">

                    <asp:Button ID="btnClose" runat="server" Text="Close" CssClass="buttonBox" CausesValidation="false" />
                </div>
            </asp:Panel>

            <asp:Button runat="server" ID="btnEmailDummy" Style="display: none" Text="btnEmailDummy" />

            <cc1:modalpopupextender id="mpeLogoutMsg" runat="server" popupcontrolid="pnlLogoutMsg" targetcontrolid="btnlogoutDummy"
                backgroundcssclass="modalBackground">
            </cc1:modalpopupextender>
            <asp:Panel ID="pnlLogoutMsg" runat="server" CssClass="modalPopup" align="center" Style="display: none; width: 70%; height: auto;">
                <asp:Panel ID="Panel2" CssClass="popHeader" runat="server">
                    <div class="popTitle">Logout Message</div>
                </asp:Panel>
                <asp:Panel ID="Panel4" runat="server" Style="margin-right: 10px">
                    <div style="text-align: left; padding: 15px; margin-left: 30px !important" class="container-fluid">
                        <p>You will now be navigated to IOP. Please log out of IOP to end your session.</p>
                    </div>
                </asp:Panel>
                <div class="btnBox btnBoxCenter" style="padding-top: 10px; width: 93%;">
                    <asp:Button ID="btnLogoutOK" runat="server" Text="Ok" CssClass="buttonBox" OnClick="btnLogoutOk_Clicked" />
                </div>
            </asp:Panel>

            <asp:Button runat="server" ID="btnlogoutDummy" aria-Label="dummyButton" Style="display: none" />

        </div>
    </form>
</body>
<script type="text/javascript">


    function CheckIfChangesHappend() {
        var authenticated = '<%=HttpContext.Current.User.Identity.IsAuthenticated%>';
        if ($('#ctl00_LoginView2_lnkLogout').is(':visible') && authenticated == 'True') {
            var isProvAdmin = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAdministrator)%>';
           var isProvAgent = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAgent)%>';

            var storage = window.sessionStorage;
            var isSpecialityChanged = storage.getItem("isSpecialityChanged");
            var isSpecChanged;
            if (isSpecialityChanged != null && isSpecialityChanged != undefined && isSpecialityChanged != '' && isSpecialityChanged == 'True') {
                $('#ctl00_MainContent_HasUnsavedData').val('True');
            }

            if ($('#ctl00_MainContent_HasUnsavedData').val() == 'True' && (isProvAdmin == 'True' || isProvAgent == 'True')) {

                var dialogObj = $("#alertLeave");
                var dialog = dialogObj.dialog({
                    modal: true,
                    title: 'ALERT - Update not submitted',
                    width: '600px',
                    buttons: {
                        'Ok': function () {
                            var lclStorage = window.sessionStorage;
                            lclStorage.removeItem("isSpecialityChanged");
                            $(this).dialog('close');
                            __doPostBack('btnbackToSummary', 'OnClick');
                        },
                        'Cancel': function () {
                            $(this).dialog('close');
                            return false;
                        }
                    },
                    open: function () {
                        $("#alertLeave").dialog('open');
                    }
                });
            }
        }
    }

    function BeforeLeaving(event, url, target) {
        var authenticated = '<%=HttpContext.Current.User.Identity.IsAuthenticated%>';
        if ($('#ctl00_LoginView2_lnkLogout').is(':visible') && authenticated == 'True') {
            var isProvAdmin = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAdministrator)%>';
            var isProvAgent = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAgent)%>';

            var storage = window.sessionStorage;
            var isSpecialityChanged = storage.getItem("isSpecialityChanged");
            var isSpecChanged;
            if (isSpecialityChanged != null && isSpecialityChanged != undefined && isSpecialityChanged != '' && isSpecialityChanged == 'True') {
                $('#ctl00_MainContent_HasUnsavedData').val('True');
            }

            if ($('#ctl00_MainContent_HasUnsavedData').val() == 'True' && (isProvAdmin == 'True' || isProvAgent == 'True')) {
                if (event) event.preventDefault ? event.preventDefault() : event.returnValue = false;
                var dialogObj = $("#alertLeave");
                var dialog = dialogObj.dialog({
                    modal: true,
                    title: 'ALERT - Update not submitted',
                    width: '600px',
                    buttons: {
                        'Ok': function () {
                            var lclStorage = window.sessionStorage;
                            lclStorage.removeItem("isSpecialityChanged");
                            $(this).dialog('close');
                            if (target == '') {
                                window.location.href = url;
                            }
                            else {
                                window.open(url, '_blank');
                            }
                        },
                        'Cancel': function () {
                            $(this).dialog('close');
                            return false;
                        }
                    },
                    open: function () {
                        $("#alertLeave").dialog('open');
                    }
                });
            }
            else {
                if (target == '') {
                    window.location.href = url;
                }
                else {
                    window.open(url, '_blank');
                }
            }
        }
        else {
            if (target == '') {
                window.location.href = url;
            }
            else {
                window.open(url, '_blank');
            }
        }
    }

    function TopMenuLeaving(event, url, target) {
        var authenticated = '<%=HttpContext.Current.User.Identity.IsAuthenticated%>';
        var appPath = '<%=HttpContext.Current.Request.ApplicationPath %>';
        //alert('AppPath: ' + appPath);
        if (appPath != '/' && target == "")
            url = appPath + url;
        if ($('#ctl00_LoginView2_lnkLogout').is(':visible') && authenticated == 'True') {
            var isProvAdmin = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAdministrator)%>';
            var isProvAgent = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAgent)%>';

            var storage = window.sessionStorage;
            var isSpecialityChanged = storage.getItem("isSpecialityChanged");
            var isSpecChanged;
            if (isSpecialityChanged != null && isSpecialityChanged != undefined && isSpecialityChanged != '' && isSpecialityChanged == 'True') {
                $('#ctl00_MainContent_HasUnsavedData').val('True');
            }

            if ($('#ctl00_MainContent_HasUnsavedData').val() == 'True' && (isProvAdmin == 'True' || isProvAgent == 'True')) {
                if (event) event.preventDefault ? event.preventDefault() : event.returnValue = false;
                var dialogObj = $("#alertLeave");
                var dialog = dialogObj.dialog({
                    modal: true,
                    title: 'ALERT - Update not submitted',
                    width: '600px',
                    buttons: {
                        'Ok': function () {
                            var lclStorage = window.sessionStorage;
                            lclStorage.removeItem("isSpecialityChanged");

                            $(this).dialog('close');
                            if (target == '') {
                                window.location.href = url;
                            }
                            else {
                                window.open(url, '_blank');
                            }
                        },
                        'Cancel': function () {
                            $(this).dialog('close');
                            return false;
                        }
                    },
                    open: function () {
                        $("#alertLeave").dialog('open');
                    }
                });
            }
            else {
                if (target == '') {
                    window.location.href = url;
                }
                else {
                    window.open(url, '_blank');
                }
            }
        }
        else {
            if (target == '') {
                window.location.href = url;
            }
            else {
                window.open(url, '_blank');
            }
        }
    }

    var onLogOff = 'false';
    function OnLogout(btn) {
        if (onLogOff != 'true') {
            var authenticated = '<%=HttpContext.Current.User.Identity.IsAuthenticated%>';
            if ($('#ctl00_LoginView2_lnkLogout').is(':visible') && authenticated == 'True') {
                var isProvAdmin = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAdministrator)%>';
                var isProvAgent = '<%=Helper.IsUserInRole(HttpContext.Current.User.Identity.Name, MAXIMUS.Core.Libraries.Constants.UserRole.ProviderAgent)%>';
                var storage = window.sessionStorage;
                var isSpecialityChanged = storage.getItem("isSpecialityChanged");
                var isSpecChanged;
                if (isSpecialityChanged != null && isSpecialityChanged != undefined && isSpecialityChanged != '' && isSpecialityChanged == 'True') {
                    $('#ctl00_MainContent_HasUnsavedData').val('True');
                }
                if ($('#ctl00_MainContent_HasUnsavedData').val() == 'True' && (isProvAdmin == 'True' || isProvAgent == 'True')) {
                    if (event) event.preventDefault ? event.preventDefault() : event.returnValue = false;
                    var dialogObj = $("#alertLeave");
                    var dialog = dialogObj.dialog({
                        modal: true,
                        title: 'ALERT - Update not submitted',
                        width: '600px',
                        buttons: {
                            'Ok': function () {
                                var lclStorage = window.sessionStorage;
                                lclStorage.removeItem("isSpecialityChanged");
                                $(this).dialog('close');
                                onLogOff = "true";
                                __doPostBack('ctl00$LoginView2$lnkLogout', '');
                            },
                            'Cancel': function () {
                                $(this).dialog('close');
                                return false;
                            }
                        },
                        open: function () {
                            $("#alertLeave").dialog('open');
                        }
                    });
                }
                else {
                    return true;
                }
            }
            else {
                return true;
            }
        }
        else {
            return true;
        }
    }
</script>
<!-- InstanceEnd -->
</html>
