                        <asp:Literal ID="ltlPwdnotification" runat="server" Text="<%$ Resources:BrandingResource , PASSWORD_EXPIRY_NOTIFICATION %>"></asp:Literal>
                    </div>
                    <br />

                    <asp:Button runat="server" ID="btnModalProfile" Text="Yes, Change Now" OnClick="btnModalProfile_Click" CausesValidation="false" Style="margin-top: 10px;" />
                    <asp:Button runat="server" ID="btnModalCancel" Text="Cancel" CausesValidation="false" Style="margin-top: 10px; margin-left: 5px;" />
                    <asp:Panel runat="server" ID="pnlProfile" Visible="false">
                        <UsrProfile:UserProfile ID="UserProfile" runat="server" />
                    </asp:Panel>
                </ContentTemplate>
            </asp:UpdatePanel>
