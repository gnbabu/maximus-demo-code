        <telerik:RadNotification RenderMode="Lightweight" ID="RadSessionNote" runat="server" Position="Center" Width="350"
            Height="180" OnCallbackUpdate="OnCallbackUpdate" LoadContentOn="PageLoad" AutoCloseDelay="60000" EnableViewState="false"
            OnClientShowing="notification_showing" OnClientHidden="notification_hidden"
            Title="Session Timeout" EnableRoundedCorners="true"
            ShowCloseButton="false" KeepOnMouseOver="false" CssClass="modalPopup">
            <ContentTemplate>
                <div>
                    Your session is about to expire
                    <br />
                    You will be logged out in :&nbsp; <span id="timeLbl">60</span> seconds<br />
                    Do you want to stay logged in?
                    <br />
                    <telerik:RadButton RenderMode="Lightweight" ID="btnContinueSession" runat="server" Text="Yes, keep me signed in"
                        Style="margin-top: 10px;" AutoPostBack="false" OnClientClicked="ContinueSession">
                    </telerik:RadButton>
                    <telerik:RadButton RenderMode="Lightweight" ID="btnLogOut" runat="server" Text="No, sign me out"
                        Style="margin-top: 10px; margin-left: 5px;" AutoPostBack="true" OnClick="btnLogOut_Clicked">
                    </telerik:RadButton>
                </div>
            </ContentTemplate>
        </telerik:RadNotification>

        <cc1:ModalPopupExtender ID="mpePassWordExpiry" runat="server" PopupControlID="pnlModal" TargetControlID="ButtonDummy1"
            CancelControlID="btnModalCancel" PopupDragHandleControlID="pnlModal" BackgroundCssClass="modalBackground">
        </cc1:ModalPopupExtender>
