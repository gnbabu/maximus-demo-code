    <asp:ContentPlaceHolder runat="server" ID="ScriptsBottom">
    </asp:ContentPlaceHolder>
    <script>
        $(function () {
            if (typeof ValidatorUpdateDisplay != 'undefined') {
                var originalValidatorUpdateDisplay = ValidatorUpdateDisplay;

                ValidatorUpdateDisplay = function (val) {
                    if (window.ariaToggle == undefined) window.ariaToggle = '';
                    if (window.ariaToggle == '.') window.ariaToggle = ''; else window.ariaToggle = '.';
                    //var title = $('#' + val.id).data('tooltip');
                    $("#" + val.id).closest(".error-wrapper").attr('aria-label', val.title + window.ariaToggle);
                    if (!val.isvalid) {
                        $("#" + val.controltovalidate).attr("aria-invalid", "true");
                        $("#" + val.id).closest(".error-wrapper").addClass("field-error");
                    }
                    else {
                        $("#" + val.id).closest(".error-wrapper").removeClass("field-error");
                        $("#" + val.controltovalidate).attr("aria-invalid", "false");
                    }

                    originalValidatorUpdateDisplay(val);
                }
            }
        });
    </script>
    <script type="text/javascript">
        //focus on modal popup if visible
        $(window).load(function () {
            $("div.modalPopup:visible").each(function () {
                $(this).focus();
                return false;
            });
        });
        $(document).ready(function () {
            // focus on the first visible and enabled input field or textarea
            $(":input:visible:enabled").each(function () {
                if (($(this).attr('type') == 'text') && ($(this).is('input')) || $(this).is('select')) {
                    $(this).focus();
                    return false;
                }
                if ($(this).is('textarea')) {
                    $(this).focus();
                    return false;
                }
            });


            $(".niceList ul li a").each(function () {

                if ($(this).attr('title') == "separator") {
                    $(this).parent(".static").css("color", "White");

                }
            });

        });
    </script>
</body>
<!-- InstanceEnd -->
</html>
