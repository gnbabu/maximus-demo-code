    <style type="text/css">
        .sm_closed ul {
            display: none;
        }

        .sm_open ul {
            display: block;
        }

        .closed ul {
            display: none;
        }

        .sb_closed ul {
            display: none;
        }

        .sb_open ul {
            display: block;
        }
    </style>
    <style type="text/css">
        .drop_menu li {
            font: 13px/1.231 arial,helvetica,clean,sans-serif;
            text-shadow: none;
            *font-size: small;
            *font: x-small;
        }

        table {
            font-size: inherit;
            font: 100%;
        }

        pre, code, kbd, samp, tt {
            font-family: monospace;
            *font-size: 108%;
            line-height: 100%;
        }
        button.hamburger:focus-visible {
          border: 2px solid black;
        }
        #sidebar-sidewrapper nav {
             display: none;
        }
        #sidewrapper.toggled #sidebar-sidewrapper nav {
             display: block;
        }
        .navbar-nav.topMenu {
            display:flex;
        }
        .navbar-nav.topMenu > li{ flex: 0 0 auto;}
        .navbar-nav > li.inline-loginView {
                display:none;
            }
        @media (max-width:1340px) {
            .navbar-nav.navbar-right {display:none;}
            .navbar-nav > li.inline-loginView {
                display:inline-block;
                flex: 1 0 auto;
                text-align: right;
            }
            .navbar-collapse{
                flex-flow:column;
            }
        }
        div#ctl00_LeftMenu {min-width:475px;margin:0 10px 0 0;}
    </style>

    <title>Provider Registration Portal</title>
    <script type="text/javascript">
        var webApi = '<%#ConfigurationManager.AppSettings["PDMSWebAPI"].ToString() %>';
        var restTokenExp = '<%#ConfigurationManager.AppSettings["RESTTokenExp"].ToString() %>';
        var webApiClaims = webApi + "Claims/";
        var webApiClaimSearch = webApi + "ClaimSearch/";
        var webApiPA = webApi + "PriorAuth/";
        var webApiHospice = webApi + "Hospice/";
        var webApiME = webApi + "MemberEligibility/";
        var webApiPrint = webApi + "PDF/";
        var webApiEnrollment = webApi + "Enrollment/";
        var webApiLogin = webApi + "Login/";
        var webApiAttachments = webApi + "Attachment/";
        $(document).ready(function () {
            var prm = Sys.WebForms.PageRequestManager.getInstance();
            prm.add_pageLoaded(setupMasterPageEventHandlers);

            var userAuthorized = <%# HttpContext.Current.Request.LogonUserIdentity.IsAuthenticated.ToString().ToLower() %>;

           
        });
        var interval = 1000 * 60 * restTokenExp; 
        setInterval(ajax_call, interval);

        function ajax_call() {
            var tokenRef = $("[id*=hdnRefreshToken]").val();
            
            //alert('url: ' + webApiLogin + "refresh");

            $.ajax({
                type: "POST",
                url: webApiLogin + "refresh",
                headers: {
                    "Access-Control-Allow-Origin": "*",
                    "Access-Control-Allow-Methods": "POST, GET, PUT, DELETE, OPTIONS",
                    "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With"

                },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({ RefreshToken: tokenRef }),
                success: function (result) {
                    // alert('result: ' + result);
                    $("[id*=hdnAccessToken]").val(result.AccessToken);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    //alert('Error: ' + jqXHR + " : " + textStatus + " : " + errorThrown);
                }
            });
        }

        function formatDate(date) {
            let day = date.getDate();
            if (day < 10) {
                day = "0" + day;
            }
            let month = date.getMonth() + 1;
            if (month < 10) {
                month = "0" + month;
            }
            let year = date.getFullYear();
            return month + "/" + day + "/" + year;
        }

        var callTrackerWindow;
        function setupMasterPageEventHandlers() {



            $(".sidebar-nav li a").click(function (e) {
                //var url = document.querySelectorAll("a[href='/PDMS/Process/CallTracker.aspx?target=_blank']");
                var $this = $(this);
                //alert($this.attr("title"));
                if ($this.attr("title") == "Call Tracker") {
                    //var url = $(".call-tracker-hidden").attr('href');
                    //debugger;
                    var url = $this.attr("href");
                    if (callTrackerWindow == null || callTrackerWindow.closed) {
                        callTrackerWindow = window.open(url, "_blank", "width=970, height=350,location=0,menubar=0,fullscreen=0,top=10, left=10");
                    }
                    else
                        callTrackerWindow.focus();
                    return false;
                }
            });
        }

        function checkShortcut(opt) {
            //event.keyCode == 8 this is Backspace. For now this is the only thing disabled.
            //event.keyCode == 13 this is Enter.
            if (event.keyCode == 8) {
                if (opt == 1) return false;
                else return true;
            }
        }

        $(document).ready(function () {
            var trigger = $('.hamburger'),
                overlay = $('.overlay'),
                isClosed = false;

            trigger.click(function () {
                hamburger_cross();
            });

            function hamburger_cross() {

                if (isClosed == true) {
                    overlay.hide();
                    trigger.removeClass('is-open');
                    trigger.addClass('is-closed');
                    isClosed = false;
                } else {
                    overlay.show();
                    trigger.removeClass('is-closed');
                    trigger.addClass('is-open');
                    isClosed = true;
                }
            }

            $('[data-toggle="offcanvas"]').click(function () {
                $('#sidewrapper').toggleClass('toggled');
            });
        });
   
        function menuButton() {
            var men = document.getElementById("menubutton").getAttribute("aria-expanded");
            if (men == "true") {
                men = "false"
            } else {
                men = "true"
            }
            document.getElementById("menubutton").setAttribute("aria-expanded", men);
        };
        function mymenu() {
            var button = document.getElementById("menu").getAttribute("aria-expanded");
            if (button == "true") {
                button = "false"
            } else {
                button = "true"
            }
            document.getElementById("menu").setAttribute("aria-expanded", button);
        };

        //Use this for before PostBack through JS
        function BlockUIPostBack(blockContainer) {
            if (typeof $.blockUI !== 'undefined') {
                $.blockUI({
                    message: '<img src="../images/loader.gif" /><br/><span style="color:white;font-weight:bold; font-size:30px">Page loading...</span>',
                    css: {
                        backgroundColor: 'transparent', // black background
                        border: 'none'
                        //color: '#fffff'          // White text
                    },
                    overlayCSS: {
                        backgroundColor: 'transparent',
                        //border: '0',
                        opacity: 0.6
                    },
                    theme: false,
                    baseZ: 1000

                });
                $.blockUI.defaults.message = '';

                $('#' + blockContainer).block();
            };
        }

    </script>

    <asp:ContentPlaceHolder ID="HtmlHead" runat="server">
    </asp:ContentPlaceHolder>
</head>
