<?xml version="1.0" encoding="utf-8"?>
<!--   For more information on how to configure your ASP.NET application, please visit https://go.microsoft.com/fwlink/?LinkId=301879 -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <!-- SET CONNECTION STRING Data source and Initial Catalog to appropriate DB for environment-->
  <connectionStrings>
    <add name="mainDB" connectionString="Data Source=uvaatmmsql02ohp.maxcorp.maximus, 26000;Initial Catalog=OH_PNM_PERF;Integrated Security=True" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
  </connectionStrings>

  <!-- SET AppSettings to appropriate Values for environment-->
  <appSettings>

    <!-- Test Keys (Do NOT set for Prod) -->
    <add key="TestAPIKey" value="removed" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- LDAP Settings -->
    <add key="BypassLdap" value="NO" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="CacheLdapForMinutes" value="10" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LdapServer" value="ldap.omes.maximus.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LdapPort" value="636" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LdapBindDN" value="dc=id,dc=ohio,dc=gov" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

  </appSettings>

</configuration>
