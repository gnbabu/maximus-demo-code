    <title>Provider Registration Portal</title>

    <script type="text/javascript">
        function checkShortcut(opt) {
            //event.keyCode == 8 this is Backspace. For now this is the only thing disabled.
            //event.keyCode == 13 this is Enter.
            if (event.keyCode == 8) {
                if (opt == 1) return false;
                else return true;
            }
        }

        var webApi = '<%#ConfigurationManager.AppSettings["PDMSWebAPI"].ToString() %>';
        window.WEB_API_URL = webApi;
        var restTokenExp = '<%#ConfigurationManager.AppSettings["RESTTokenExp"].ToString() %>';
        var webApiEnrollment = webApi + "Enrollment/";


        $(document).ready(function () {
            var trigger = $('.hamburger'),
                overlay = $('.overlay'),
                isClosed = false;

            trigger.click(function () {
                hamburger_cross();
            });

            function hamburger_cross() {

                if (isClosed == true) {
                    overlay.hide();
                    trigger.removeClass('is-open');
                    trigger.addClass('is-closed');
                    isClosed = false;
                } else {
                    overlay.show();
                    trigger.removeClass('is-closed');
                    trigger.addClass('is-open');
                    isClosed = true;
                }
            }

            $('[data-toggle="offcanvas"]').click(function () {
                $('#sidewrapper').toggleClass('toggled');
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            // focus on the first visible and enabled input field or textarea
            $(":input:visible:enabled").each(function () {
                if (($(this).attr('type') == 'text') && ($(this).is('input')) || $(this).is('select')) {
                    $(this).focus();
                    return false;
                }
                if ($(this).is('textarea')) {
                    $(this).focus();
                    return false;
                }
            });

            function getFocusable(context = 'document') {
                return Array.from(context.querySelectorAll('button, [href], input:not([type="hidden"]), textarea, select, [tabindex]:not([tabindex="-1"])')).filter(function (el) { return !el.closest('[hidden]'); });
            }

            const $dialog = document.querySelector('#ctl00_pnlModalNotes');
            const focusableItems = getFocusable($dialog);

            document.addEventListener("keydown", function (e) {
                if (e.keyCode === 9) { // Tab & Shift+Tab
                    const focusedItem = e.target;
                    const focusedItemIndex = focusableItems.indexOf(focusedItem);
                    if (e.shiftKey) {
                        if (!$dialog.contains(e.target) || focusedItemIndex == 0) {
                            focusableItems[focusableItems.length - 1].focus();
                            //e.preventDefault();
                        }
                    } else {
                        if (!$dialog.contains(e.target) || focusedItemIndex == focusableItems.length - 1) {
                            focusableItems[0].focus();
                            //e.preventDefault();
                        }
                    }
                }
            });
        });


        function toggle(lnk_obj) {
            lnk_obj.innerHTML = (lnk_obj.innerHTML == 'Less...') ? 'More...' : 'Less...';
        }
    </script>

    <style type="text/css">
        .header {
            background-color: #ffffff;
            color: black;
            padding: 10px 20px;
            font-size: 30px;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            /*display: flex;*/
            user-select: none;
            text-align: start !important;
        }

        .toggle-btn {
            background: none;
            border: none;
            color: black;
            font-size: 25px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
        }

        /* Target the icon specifically to make it smaller and thinner */
        .header .toggle-btn .glyphicon {
            font-size: 20px !important; /* Reduced size makes it look thinner */
            font-weight: 100 !important; /* Lightest weight */
            line-height: 1;
            text-shadow: none !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Remove any default Bootstrap bolding on icons */
        .glyphicon-menu-hamburger:before, .glyphicon-remove:before {
            font-weight: 100 !important;
        }

        /* Apply color to the link and icon */
        .user-login-link,
        .user-login-link strong {
            color: white !important;
            text-decoration: none;
        }

        .user-icon-container {
            padding-right: 5px;
            display: inline-block;
            vertical-align: middle;
        }

        /* Style the Glyphicon specifically */
        .user-login-link .glyphicon-user {
            color: white;
            font-size: 18px; /* Adjusted to look similar to the 21px image */
            font-weight: 400 !important; /* Ensures it is not bold */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Ensure no hover color change unless desired */
        .user-login-link:hover, .user-login-link:focus {
            color: white !important;
            text-decoration: underline;
        }
        /* Apply color to the logout link and text */
        .logout-link {
            color: white !important;
            text-decoration: none;
            font-weight: 600; /* Matching your header font weight if desired */
        }

            /* Style the Logout Glyphicon specifically */
            .logout-link .glyphicon-log-out {
                color: white;
                font-size: 16px; /* Matches the original 18px image scale */
                font-weight: 400 !important; /* Prevents bolding */
                vertical-align: middle;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            .logout-link:hover, .logout-link:focus {
                color: white !important;
                text-decoration: underline;
            }
    </style>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#sidebarToggleBtn').click(function () {
                // Toggles the 'toggled' class on the parent container to show/hide sidebar
                $('#sidewrapper').toggleClass('toggled');

                // Swap between Hamburger and Close icons
                var icon = $(this).find('#toggleIcon');
                if (icon.hasClass('glyphicon-menu-hamburger')) {
                    icon.removeClass('glyphicon-menu-hamburger').addClass('glyphicon-remove');
                    $(this).attr('aria-expanded', 'true');
                } else {
                    icon.removeClass('glyphicon-remove').addClass('glyphicon-menu-hamburger');
                    $(this).attr('aria-expanded', 'false');
                }
            });
        });
    </script>
</head>
<body>
    <script type="text/javascript">
        $(document).keydown(function (e) {
            // ESCAPE key pressed
            if (e.keyCode == 27) {
                $find("bhmpeNotesGrid").hide();
                document.getElementById("<%=btnNotes.ClientID %>").focus();
                return false;
            }
        });
    </script>
