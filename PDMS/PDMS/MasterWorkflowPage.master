        <div style="display: none;">
            <span class="timeSeconds"><span id="mainLbl"><%=TimeOutValue%></span></span>seconds
        </div>
        <div id="alertLeave" title="ALERT-Update not submitted" style="display: none;">
            <div class="left">
                You have started an update on this registration that has not been submitted for State Medicaid processing.This update is not complete until changes are saved and the Submit for Review button is clicked.
            </div>
            <br />
            <div>Selecting OK will navigate away from this update. Clicking Cancel will stay on current page and allow Update to continue.</div>
        </div>
        <telerik:radnotification rendermode="Lightweight" id="RadSessionNote" runat="server" position="Center" width="350"
            height="255" oncallbackupdate="OnCallbackUpdate" loadcontenton="PageLoad" autoclosedelay="60000" enableviewstate="false"
            onclientshowing="notification_showing" onclienthidden="notification_hidden"
            title="Session Timeout" enableroundedcorners="true"
            showclosebutton="false" keeponmouseover="false" cssclass="modalPopup">
            <contenttemplate>
                <div>
                    Your session is about to expire
                    <br />
                    You will be logged out in :&nbsp; <span id="timeLbl">60</span> seconds<br />
                    Do you want to stay logged in?
                    <br />
                    <telerik:radbutton rendermode="Lightweight" id="btnContinueSession" runat="server" text="Yes, keep me signed in"
                        style="margin-top: 10px;" autopostback="false" onclientclicked="ContinueSession">
                    </telerik:radbutton>
                    <telerik:radbutton rendermode="Lightweight" id="btnLogOut" runat="server" text="No, sign me out"
                        style="margin-top: 10px; margin-left: 5px;" autopostback="true" onclick="btnLogOut_Clicked">
                    </telerik:radbutton>
                </div>
            </contenttemplate>
        </telerik:radnotification>
        <script type="text/javascript" src="../Scripts/sessionTimeout.js"> </script>
        <script type="text/javascript">
            //<![CDATA[
            serverIDs({ notificationID: '<%= RadSessionNote.ClientID %>' });
            //]]>
        </script>
