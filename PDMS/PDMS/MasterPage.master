    <style type="text/css">
        .sm_closed ul {
            display: none;
        }

        .sm_open ul {
            display: block;
        }

        .closed ul {
            display: none;
        }

        .sb_closed ul {
            display: none;
        }

        .sb_open ul {
            display: block;
        }

        div[class^='container'], div[class*='container'] {
            padding: 0 8px !important;
        }

        div[class^='row'], div[class*='row'] {
            margin: 0 -8px !important;
        }

        div[class^='col'], div[class*='col'] {
            padding: 0 8px !important;
        }

        button {
            outline: none !important
        }

        div#ctl00_LeftMenu {
            /*min-width: 180px !important;
            margin: 0px !important;*/
        }

        :root {
            --theme_color: #112e51;
            --lightgrey: #F3F7FE;
            --midGrey: #9192C4;
            --white: #ffffff;
            --very-dark-grey: #26262E;
            --dark-blue: #5152B7;
            --greylight-pink: #F4EEEE;
            --dark-grey: #26262E;
            --sky-light-blue: #B6C7E1;
        }

        @font-face {
            font-family: 'Noto Sans Regular';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Regular'), url('../fonts/NotoSans-Regular.woff') format('woff');
        }


        @font-face {
            font-family: 'Noto Sans Regular';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Regular'), url('../fonts/NotoSans[wdth,wght].woff') format('woff');
        }


        @font-face {
            font-family: 'Noto Sans Italic';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Italic'), url('../fonts/NotoSans-Italic.woff') format('woff');
        }


        @font-face {
            font-family: 'Noto Sans Italic';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Italic'), url('../fonts/NotoSans-Italic[wdth,wght].woff') format('woff');
        }


        @font-face {
            font-family: 'Noto Sans Bold';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Bold'), url('../fonts/NotoSans-Bold.woff') format('woff');
        }


        @font-face {
            font-family: 'Noto Sans Bold Italic';
            font-style: normal;
            font-weight: normal;
            src: local('Noto Sans Bold Italic'), url('../fonts/NotoSans-BoldItalic.woff') format('woff');
        }

        body {
            font-family: 'Noto Sans Regular',arial, helvetica, sans-serif !important;
            font-optical-sizing: auto;
            font-style: normal;
            overflow-x: hidden;
            text-align: left;
        }

        a, a:link, a:visited, a:active, a:hover {
            text-decoration: none !important;
            color: inherit
        }

        .navbar-custom {
            background-color: #004e9a !important
        }

        .navbar-collapse.collapse {
            align-items: center
        }

        .navbar-custom .navbar-nav > li > a {
            /*display: inline-flex;
            padding: 1rem 1rem;*/
            text-decoration: none;
            /*border-radius: 2px;*/
            color: white !important;
            /* transition: all 400ms ease-in-out;*/
            font-weight: 600;
            font-size: 14pt;
            margin-left: 12px;
            border-bottom: 4px solid transparent;
        }

            .navbar-custom .navbar-nav > li > a:hover, .navbar-custom .navbar-nav > li > a:active {
                /* background-color: var(--theme_color);
                color: var(--white) !important;*/
                border-bottom: 4px solid #28a0cb;
                text-decoration: none;
            }

            .navbar-custom .navbar-nav > li > a:after {
                display: none !important
            }

        .hamburger.is-open .hamb-top, .hamburger.is-open .hamb-middle, .hamburger.is-open .hamb-bottom {
            background-color: var(--very-dark-grey) !important
        }

        .hamburger.is-closed .hamb-top, .hamburger.is-closed .hamb-middle, .hamburger.is-closed .hamb-bottom {
            background-color: var(--very-dark-grey) !important
        }


        .navbar-nav.topMenu {
            flex-wrap: nowrap !important;
            justify-content: center;
            color: white !important;
        }

        button {
            outline: 0 !important
        }

        /*New Footer*/
        #footer-font {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
            margin-top: -150px;
        }

        #main-footer {
            background-color: #ECEFF1;
            color: black;
            padding-right: 2rem;
            padding-top: 0.5rem;
            border-top: 1px solid #B6C7E1;
        }

        footer a {
            color: black !important;
            display: inline-block;
            padding: 0.3rem 0;
            text-decoration: none !important
        }

        .footer-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-left: 10px;
            margin-right: auto;
            gap: 2rem;
            user-select: none;
        }

        .footer-column {
            flex: 1 1 250px;
            text-align: justify;
            color: black !important;
        }

            .footer-column h4 {
                font-size: 16px;
                margin-bottom: 10px;
                color: black !important;
            }

            .footer-column p,
            .footer-column ul {
                font-size: 14px;
                line-height: 1.6;
            }

            .footer-column ul {
                list-style: none;
                padding: 0;
            }

                .footer-column ul li {
                    margin-bottom: 6px;
                }


            .footer-column a {
                color: #ffffff;
                text-decoration: none;
            }

                .footer-column a:hover {
                    text-decoration: underline;
                }


        .footer-bottom {
            text-align: center;
            margin-top: 30px;
            font-size: 13px;
            color: #cccccc;
        }

        .govt-footer {
            background-color: rgb(135 146 157 / 2%);
            color: #162e51;
            text-align: center;
            font-size: 12px;
            padding: 10px 15px;
        }

            .govt-footer a {
                color: #162e51 !important;
                text-decoration: none;
            }

        .footer-header {
            color: black;
            font-size: 40px;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
        }

        .return-to-top {
            text-align: right;
            margin-bottom: 5px;
        }

            .return-to-top a {
                color: #fff;
                text-decoration: none;
                font-size: 14px;
                text-decoration: none !important
            }

                .return-to-top a:hover {
                    text-decoration: underline;
                }

        #sidebar-sidewrapper {
            position: fixed;
            width: 320px;
            background-color: #004e9a !important;
            height: 100vh;
            left: -340px;
            z-index: 9;
            top: 0;
            transition: all 400ms ease-in-out;
        }

        .left-brandin {
            height: 80px;
            background-color: var(--white);
            margin-bottom: 3rem;
        }

        #sidebar-sidewrapper.active {
            left: 0;
            transition: all 400ms ease-in-out;
        }

        .hamburger-width-inmenu span {
        }

        #sidebar-sidewrapper a {
            display: block;
            font-size: 12pt;
            /*margin: 0.1rem .8rem !important;*/
            padding: 12px 30px !important;
            color: #fff !important;
            background-color: transparent;
            border-radius: 4px;
            transition: all 400ms ease-in-out;
        }

        .sidebar-nav {
            padding: 2rem 0 !important;
        }



            .sidebar-nav li a::after {
                display: none !important;
            }

        #sidebar-sidewrapper a:hover {
            background-color: #28a0cb !important;
            color: var(--white) !important;
            transition: all 400ms ease-in-out;
        }

        /* #sidebar-sidewrapper {
          background-color: var(--white) !important;
          color: var(--midGrey) !important;
          padding: 3rem !important;
          border-top: 1px solid #B6C7E1 !important
      }

          #sidebar-sidewrapper a {
              color: var(--midGrey) !important;
              display: inline-block;
              padding: 0.3rem 0;
          }

              #sidebar-sidewrapper a:hover {
                  background-color: var(--white) !important;
                  color: var(--dark-grey) !important;
                  transition: all 400ms ease-in-out;
              }*/
    </style>
    <style type="text/css">
        .drop_menu li {
            font: 13px/1.231 arial,helvetica,clean,sans-serif;
            text-shadow: none;
            *font-size: small;
            *font: x-small;
        }

        table {
            font-size: inherit;
            font: 100%;
        }

        pre, code, kbd, samp, tt {
            font-family: monospace;
            *font-size: 108%;
            line-height: 100%;
        }

        button.hamburger:focus-visible {
            border: 2px solid black;
        }

        #sidebar-sidewrapper nav {
            display: none;
        }

        #sidewrapper.toggled #sidebar-sidewrapper nav {
            display: block;
        }

        .navbar-nav.topMenu {
            display: flex;
        }

            .navbar-nav.topMenu > li {
                flex: 0 0 auto;
            }

        .navbar-nav > li.inline-loginView {
            display: none;
        }

        @media (max-width:1340px) {
            .navbar-nav.navbar-right {
                display: none;
            }

            .navbar-nav > li.inline-loginView {
                display: inline-block;
                flex: 1 0 auto;
                text-align: right;
            }

            .navbar-collapse {
                flex-flow: column;
            }
        }

        #ctl00_LeftMenu ul.navbar-left, #ctl00_LeftMenu ul.navbar-nav {
            /*display: flex !important;
            flex-wrap: nowrap !important*/
        }

        a.logo_brand:hover {
            background-color: transparent !important;
        }

        a.logo_brand {
            padding: 0px !important;
            margin: 0px !important;
        }
    </style>
    <style type="text/css">
        .divGrid {
            width: 100%;
        }

        .gridview {
            float: right;
        }

        .gridViewHeader > th > a {
            color: White;
        }

        .panelOwnerInfo {
            padding: 20px 20px 0px 20px;
        }

        td, th {
            padding: 4px !important;
        }

        .row {
            margin-top: 2px;
            margin-bottom: 2px;
        }

        .col-sm-3 {
            width: 23%;
        }

        .textAlignCentre {
            text-align: center;
        }

        .radioButtonList {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .radioButtonList.horizontal li {
                display: inline;
            }

            .radioButtonList label {
                display: inline;
            }

        .ph2 {
            padding-left: 10px;
            color: white;
        }

        .buttonBoxFocusred {
            color: #fff;
            background-color: #b50909 !important;
            /*border-color: #eea236 !important;*/
            /*background:none !important;*/
            font-weight: bold;
            padding: 7px 12px;
            line-height: 1.2 !important;
            border-radius: 4px !important;
            text-shadow: none !important;
            border: 1px solid transparent !important;
            width: auto;
            min-width: 92px;
            font-size: 18px;
        }

        #wrapper {
            /* background: linear-gradient(131deg, rgba(241,241,252,1) 0%, rgba(200,229,255,1) 100%)*/
            background-color: #f7f7f7;
        }

        .WhiteBox, .OwnerBackground {
            border-radius: 14px;
            padding: 20px 40px 40px 40px !important
        }

        .row.col-sm-12 {
            border-width: 0px !important;
            border-color: transparent !important;
        }

        .row.col-sm-13 {
            border-width: 0px !important;
            border-color: transparent !important;
        }

        .row.col-sm-15 {
            border-width: 0px !important;
            border-color: transparent !important;
        }

        .CollapsingSeparator {
            background: #7993ac !important;
            padding: 8px !important;
            margin-bottom: 4px !important
        }

            .CollapsingSeparator h1, .CollapsingSeparator h2 {
                padding: 0px !important;
                margin: 0px !important
            }

        h1 .pageHeader, h2 .pageHeader {
            color: #fff !important
        }

        .RadGrid_DCPDMS {
            border: 0px solid transparent !important
        }

        .panelHeaderStyle {
            background-color: transparent !important;
            border-style: none;
        }

        div[class^='col'], div[class*='col'] {
            padding: 2px 8px !important;
        }
    </style>

