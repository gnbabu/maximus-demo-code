                                            </asp:HyperLink>
                                        </li>
                                        <li>
                                            <%--<asp:LoginStatus LogoutAction="Redirect" ID="LoginStatus1" runat="server" class="panelLink" LogoutText="&lt;i aria-hidden=&quot;true&quot; class=&quot;glyphicon glyphicon-off&quot;&gt;&lt;/i&gt;&nbsp;Log out" OnLoggingOut="LoginStatus1_LoggingOut" OnLoggedOut="LoginStatus1_LoggedOut" ></asp:LoginStatus>--%>
                                            <asp:LinkButton ID="LinkButton1" runat="server" CssClass="panelLink logout-link" OnClick="lnkLogout_Click">
                                                <span class="user-icon-container">
                                                    <i class="glyphicon glyphicon-log-out"></i>
                                                </span>Log out
                                            </asp:LinkButton>
                                        </li>
                                    </loggedintemplate>
                                </asp:LoginView>
                            </ul>
                        </div>
                    </div>
                </nav>

                <div id="NewMainForm">
                    <%--  id="mainForm" --%>
