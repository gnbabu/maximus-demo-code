        <add name="CustomSqlMembershipProvider" type="MAXIMUS.Services.PDMS.MembershipProvider.CustomSqlMembershipProvider" connectionStringName="mainDB" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="false" maxInvalidPasswordAttempts="6" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" passwordAttemptWindow="10" enablePasswordHistoryCheck="false" applicationName="/PDMS" />
