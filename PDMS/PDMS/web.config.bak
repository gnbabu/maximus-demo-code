    <healthMonitoring>
      <bufferModes>
        <add name="Extra Critical Notification" maxBufferSize="10" maxFlushSize="5" regularFlushInterval="00:02:00" urgentFlushThreshold="1" urgentFlushInterval="00:01:00" maxBufferThreads="1" />
      </bufferModes>
      <providers>
        <add connectionStringName="mainDB" maxEventDetailsLength="1073741823" buffer="true" bufferMode="Extra Critical Notification" name="MySqlWebEventProvider" type="System.Web.Management.SqlWebEventProvider,System.Web,Version=4.0.0.0,Culture=neutral,PublicKeyToken=b03f5f7f11d50a3a" />
        <add name="MyEventLogWebEventProvider" type="System.Web.Management.EventLogWebEventProvider,System.Web,Version=4.0.0.0,Culture=neutral,PublicKeyToken=b03f5f7f11d50a3a" />
      </providers>
      <profiles>
        <add name="Default" minInstances="1" maxLimit="Infinite" minInterval="00:01:00" custom="" />
        <add name="Critical" minInstances="1" maxLimit="Infinite" minInterval="00:00:00" custom="" />
        <add name="Throttle" minInstances="1" maxLimit="1000" minInterval="00:00:01" />
      </profiles>
      <eventMappings>
        <add name="MapPasswordChangedEvent" type="PdmsWebEvents.PasswordChangedEvent,PdmsWebEvents" />
        <add name="MapAccountLockedEvent" type="PdmsWebEvents.AccountLockedEvent,PdmsWebEvents" />
        <add name="MapWebFailureAuditEvent" type="System.Web.Management.WebFailureAuditEvent,System.Web,Version=4.0.0.0,Culture=neutral,PublicKeyToken=b03f5f7f11d50a3a" />
        <add name="MapWebAuthenticationSuccessAuditEvent" type="System.Web.Management.WebAuthenticationSuccessAuditEvent,System.Web,Version=4.0.0.0,Culture=neutral,PublicKeyToken=b03f5f7f11d50a3a" />
        <add name="MapPageLoadEvent" type="PdmsWebEvents.PageLoadEvent,PdmsWebEvents" />
      </eventMappings>
      <rules>
        <add name="PasswordChangedEvent Critical" eventName="MapPasswordChangedEvent" provider="MySqlWebEventProvider" profile="Critical" />
        <add name="AccountLockedEvent Throttle" eventName="MapAccountLockedEvent" provider="MySqlWebEventProvider" profile="Throttle" />
        <add name="WebFailureAuditEvent Throttle" eventName="MapWebFailureAuditEvent" provider="MySqlWebEventProvider" profile="Throttle" />
        <add name="WebAuthenticationSuccessAuditEvent Default" eventName="MapWebAuthenticationSuccessAuditEvent" provider="MySqlWebEventProvider" profile="Default" />
        <add name="PageLoadEvent Critical" eventName="MapPageLoadEvent" provider="MySqlWebEventProvider" profile="Critical" />
      </rules>
    </healthMonitoring>
    <sessionState timeout="60" />
    <!--<customErrors mode="RemoteOnly" defaultRedirect="~/Exception.aspx" />-->
    <!-- Please keep this on since it goes to E2E UAT and Prod -->
    <customErrors mode="On" defaultRedirect="~/Exception.aspx" />
