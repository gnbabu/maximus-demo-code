<xs:schema elementFormDefault="qualified" targetNamespace="http://mes.gov/providermanagement" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://mes.gov/providermanagement">
   <xs:include schemaLocation="ProviderManagement_Datatypes.xsd"/>
   <xs:element name="MessageHeader">
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="tns:InqMessageHeader">
               <xs:sequence>
                  <xs:element name="SITransactionKey" type="tns:String32" minOccurs="0" maxOccurs="1"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:complexType name="InqMessageHeader">
      <xs:sequence>
