               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="RequestorSystem" minOccurs="1" maxOccurs="1">
            <xs:simpleType>
               <xs:restriction base="xs:string">
                  <xs:minLength value="1"/>
                  <xs:maxLength value="50"/>
                  <xs:pattern value="([\S+\s])*\S+\s*"/>
                  <xs:enumeration value="MITS"/>
                  <xs:enumeration value="FI"/>
                  <xs:enumeration value="SPBM"/>
                  <xs:enumeration value="PSM"/>
                  <xs:enumeration value="PCW"/>
                  <xs:enumeration value="PNM"/>
                  <xs:enumeration value="HealthCheck"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <!--HMP-4088: Start of changes-->
         <xs:element name="SubscriberSystem" minOccurs="1" maxOccurs="1">
            <xs:complexType>
               <xs:sequence>
                  <xs:element name="Subscriber" minOccurs="1" maxOccurs="10">
                     <xs:simpleType>
                        <xs:restriction base="xs:string">
                           <xs:minLength value="1"/>
                           <xs:maxLength value="50"/>
                           <xs:pattern value="([\S+\s])*\S+\s*"/>
                           <xs:enumeration value="PSM"/>
                           <xs:enumeration value="PCW"/>
                           <xs:enumeration value="FI"/>
                           <xs:enumeration value="MITS"/>
                           <xs:enumeration value="SPBM"/>
						   <xs:enumeration value="EVV"/>
                           <xs:enumeration value="ALL"/>
                        </xs:restriction>
                     </xs:simpleType>
                  </xs:element>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <!--HMP-4088: End of changes-->
         <xs:element name="ModuleTransactionId" type="tns:String50" minOccurs="0" maxOccurs="1"/>
         <xs:element name="AdditionalModuleTransactionId" type="tns:String50" minOccurs="0" maxOccurs="1"/>
         <xs:element name="RequestTimestamp" type="tns:MDateType" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="Fault">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="faultcode" type="xs:string" minOccurs="0"/>
            <xs:element name="faultstring" type="xs:string" minOccurs="0"/>
