<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://mes.gov/providermanagement" xmlns:tns="http://mes.gov/providermanagement">
	<xsd:include schemaLocation="ProviderManagement_Datatypes.xsd"/>
	<xsd:element name="SearchProvider">
		<xsd:complexType>  
			<xsd:sequence>                            					         
				<xsd:element maxOccurs="1" minOccurs="0" name="NationalProviderIdentifier" type="tns:String10"/>
				<!--STRY0010946:Increasing ProviderId length from 20 to 71-->
				<xsd:element maxOccurs="1" minOccurs="0" name="ProviderId" type="tns:String71"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="CurrentTaxId" type="tns:String9"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="FirstName" type="tns:String40"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="LastName" type="tns:String40"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="BusinessStatusCode" type="tns:String50"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="InputOffset" type="tns:Int"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="InputLimit" type="tns:Int"/>
				<xsd:element minOccurs="0" name="RecordStatusCode" type="tns:String50"/>   
			</xsd:sequence>                            					         
		</xsd:complexType>                           					             
	</xsd:element> 
	<xsd:element name="SearchProviderHistory">
		<xsd:complexType>  
			<xsd:sequence>       
				<!--STRY0010946:Increasing ProviderId length from 20 to 71-->
				<xsd:element maxOccurs="1" minOccurs="1" name="ProviderId" type="tns:string71"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="InputOffset" type="tns:Int"/>
				<xsd:element maxOccurs="1" minOccurs="0" name="InputLimit" type="tns:Int"/>
				<xsd:element minOccurs="0" name="RecordStatusCode" type="tns:String50"/>  
			</xsd:sequence>                            					         
		</xsd:complexType>                           					             
	</xsd:element>

