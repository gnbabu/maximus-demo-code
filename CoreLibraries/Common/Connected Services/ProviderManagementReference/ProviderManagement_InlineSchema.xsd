			<xsd:element minOccurs="0" name="ProvOrgFaxNumber2" type="tns:String10"/>
			<xsd:element minOccurs="0" name="ProvAddressContactName" type="tns:String50"/>
			<xsd:element minOccurs="0" name="ProvEmail" type="tns:String50"/>
			<xsd:element minOccurs="0" name="HandicapAccessibilityIndicator" type="tns:String1"/>
