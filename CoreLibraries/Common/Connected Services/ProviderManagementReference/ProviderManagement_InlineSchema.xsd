			<xsd:element minOccurs="0" name="ProvOrgAddressName" type="tns:String100"/>
			<xsd:element minOccurs="0" name="ProvOrgAddressFirstName" type="tns:String50"/>
			<xsd:element minOccurs="0" name="ProvOrgAddressMiddleName" type="tns:String50"/>
			<xsd:element minOccurs="0" name="ProvOrgAddressLastName" type="tns:String50"/>
			<xsd:element minOccurs="0" name="ProvOrgPhoneNumber1" type="tns:String10"/>
			<xsd:element minOccurs="0" name="ProvOrgPhoneNumberExt1" type="tns:String5"/>
