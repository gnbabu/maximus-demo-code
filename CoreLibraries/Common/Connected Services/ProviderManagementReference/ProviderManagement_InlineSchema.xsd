			<xsd:element minOccurs="1" name="EffectiveDate" type="tns:MDateType"/>
			<xsd:element minOccurs="0" name="EndDate" type="tns:DateType"/>
			<!--HMP-3992: Added Latitude and Longitude-->
			<xsd:element minOccurs="0" name="Latitude" type="tns:String50"/>
			<xsd:element minOccurs="0" name="Longitude" type="tns:String50"/>
		</xsd:sequence>  
	</xsd:complexType>
	<xsd:complexType name="EnrollProviderLicense">                            					         
		<xsd:sequence>   
			<xsd:element minOccurs="0" name="RecordStatusCode" type="tns:String50"/>   <!--Change by shivi-->
			<xsd:element minOccurs="1" name="LicenseType" type="tns:string50"/>
			<!--STRY0010889:XSD ODS Discrepancies fix:Start-->
			<xsd:element minOccurs="1" name="LicenseNumber" type="tns:string25"/>
			<!--STRY0010889:XSD ODS Discrepancies fix:End-->
			<!--HMP-2964 (HEAL-17628) changes start-->
			<xsd:element minOccurs="0" name="LicenseeStateCode" type="tns:String50"/>
			<!--HMP-2964 (HEAL-17628) changes end-->
			<xsd:element minOccurs="0" name="LicenseIssueBoardNotes" type="tns:String40"/>
			<xsd:element minOccurs="0" name="Status" type="tns:String20"/>
			<xsd:element minOccurs="0" name="StatusReason" type="tns:String20"/>
			<!--STRY0010932: Start of OH addition of new elements-->
			<xsd:element minOccurs="0" name="CountyCode" type="tns:String50"/>
			<!--STRY0010932: End of OH addition of new elements-->
			<xsd:element minOccurs="1" name="EffectiveDate" type="tns:MDateType"/>
			<xsd:element minOccurs="0" name="EndDate" type="tns:DateType"/>
		</xsd:sequence>                            					         
	</xsd:complexType>                           					             
	<xsd:complexType name="EnrollProviderServiceLocation">                            					         
		<xsd:sequence> 
