	<!-- Start of Create provider schema -->	
	<xsd:complexType name="EnrollProviderInformation">                            					         
		<xsd:sequence> 
			<xsd:element name="ProviderDemographics" type="tns:EnrollProviderDemographics"/>	
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderAddress">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Address" maxOccurs="50" minOccurs="0">
							<xsd:complexType>
								<xsd:complexContent>
									<xsd:extension base="tns:EnrollProviderAddress">
										<xsd:sequence>
											<xsd:element minOccurs="0" name="ProvAddressSrcKey" type="tns:String36"/>
										</xsd:sequence>
									</xsd:extension>
								</xsd:complexContent>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
				<xsd:unique name="AddressUniqueKeyCreate">
					<xsd:selector xpath="tns:Address"/>
					<xsd:field xpath="tns:AddressType"/>
					<!-- SCTASK0033390; Adding EffectiveDate as unique key -->
					<xsd:field xpath="tns:EffectiveDate"/>
				</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderContact" type="tns:ProviderContactList">
						<xsd:unique name="ContactUniqueKeyCreate">
							<xsd:selector xpath="tns:Contact"/>
							<xsd:field xpath="tns:ContactType"/>
						</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderApplication" type="tns:enrollProviderApplicationList">
					<xsd:unique name="ApplicationUniqueKeyCreate">
							<xsd:selector xpath="tns:Application"/>
							<xsd:field xpath="tns:ApplicationId"/>
					</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderAlternateIdentifiers" type="tns:ProviderAlternateIdList">
					<xsd:unique name="AlternateIdentifierUniqueKeyCreate">
						<xsd:selector xpath="tns:AlternateIdentifier"/>
						<xsd:field xpath="tns:AlternateIdType"/>
						<xsd:field xpath="tns:AlternateId"/>
						<!-- STRY0011038; Adding EffectiveDate as unique key -->
						<xsd:field xpath="tns:EffectiveDate"/>
					</xsd:unique>
			</xsd:element>
			
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderType" type="tns:ProviderTypeList">
					<xsd:unique name="TypeUniqueKeyCreate">
						<xsd:selector xpath="tns:Type"/>
						<xsd:field xpath="tns:ProviderTypeCode"/>
					</xsd:unique>
			</xsd:element>			
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderAffiliations" type="tns:ProviderAffiliationList">
						<xsd:unique name="AffiliationsUniqueKeyCreate">
							<xsd:selector xpath="tns:Affiliations"/>
							<xsd:field xpath="tns:ProviderAffiliationTypeCode"/>				
							<xsd:field xpath="tns:AffiliatedProviderId"/>							
							<!-- STRY0011038; Adding EffectiveDate as unique key -->
							<xsd:field xpath="tns:EffectiveDate"/>
						</xsd:unique>
			</xsd:element>	
			<!--Provider Ownership change -->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderOwnerships">
                         <xsd:complexType>
                          <xsd:sequence>
                           <xsd:element maxOccurs="500" minOccurs="0" name="ProviderOwnership" type="tns:ProviderOwnershipList"/>
                           </xsd:sequence>
                         </xsd:complexType>
			 <!-- CR166 Start: Unique key contraints for Owner SSN and OrgTaxId-->
			 <!-- PROGCR306: Add OwnerType field as unique contraint along with OrgTaxId -->
				<xsd:unique name="OwnerOrgTaxIdNumberUniqueKeyCreate">
						<xsd:selector xpath="tns:ProviderOwnership"/>
						<xsd:field xpath="tns:OwnershipDetails/tns:OwnerType"/>
						<xsd:field xpath="tns:OwnershipDetails/tns:OwnerOrganization/tns:OrgTaxIdNumber"/>
				</xsd:unique>
				<xsd:unique name="OwnerSSNUniqueKeyCreate">
						<xsd:selector xpath="tns:ProviderOwnership"/>
						<xsd:field xpath="tns:OwnershipDetails/tns:OwnerIndividual/tns:SSN"/>
				</xsd:unique>
			<!--CR166 End-->
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="OwnerRelationship" type="tns:OwnerRelationshipList">
						<!-- OH PROGCR305: changing the unique Key for OwnerRelationship element -->
						<xsd:unique name="RelationshipUniqueKeyCreate1">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner1SSN"/>
							<xsd:field xpath="tns:Owner2SSN"/>
						</xsd:unique>
						<xsd:unique name="RelationshipUniqueKeyCreate2">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner1OrgTaxIdNumber"/>
							<xsd:field xpath="tns:Owner2OrgTaxIdNumber"/>
						</xsd:unique>
						<xsd:unique name="RelationshipUniqueKeyCreate3">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner1SSN"/>
							<xsd:field xpath="tns:Owner2OrgTaxIdNumber"/>
						</xsd:unique>
						<xsd:unique name="RelationshipUniqueKeyCreate4">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner1OrgTaxIdNumber"/>
							<xsd:field xpath="tns:Owner2SSN"/>
						</xsd:unique>
						<xsd:unique name="RelationshipUniqueKeyCreate5">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner2SSN"/>
							<xsd:field xpath="tns:Owner2OrgTaxIdNumber"/>
						</xsd:unique>
						<xsd:unique name="RelationshipUniqueKeyCreate6">
							<xsd:selector xpath="tns:Relationship"/>
							<xsd:field xpath="tns:RelationType"/>
							<xsd:field xpath="tns:Owner1OrgTaxIdNumber"/>
							<xsd:field xpath="tns:Owner1SSN"/>
						</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderManagedEmployees" type="tns:ProviderManagedEmployeesList">
						<xsd:unique name="ProviderManagedEmployeesUniqueKeyCreate">
							<xsd:selector xpath="tns:ProviderManagedEmployee"/>
							<!-- SCTASK0033390; FI-198 Defect fix modified the SSN tag below -->
							<xsd:field xpath="tns:ManagedEmployee/tns:SSN"/>
						</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderBusinessStatus" type="tns:ProviderBusinessStatusList">
						<xsd:unique name="BusinessStatusUniqueKeyCreate">
							<xsd:selector xpath="tns:BusinessStatus"/>
							<xsd:field xpath="tns:BusinessStatusCode"/>
							<xsd:field xpath="tns:EffectiveDate"/>
						</xsd:unique>
			</xsd:element>	
						<!--End of Provider Ownership change -->

			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderTaxonomyClassification" type="tns:TaxonomyClassificationList">  <!--Added for TMSIS reporting-->
						<xsd:unique name="TaxonomyClassificationUniqueKeyCreate">
							<xsd:selector xpath="tns:TaxonomyClassification"/>
							<xsd:field xpath="tns:ClassificationTypeCode"/>
						</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderProgramAffiliations" type="tns:ProgramAffiliationsList">  <!--Added for TMSIS reporting-->
						<xsd:unique name="ProgramAffiliationUniqueKeyCreate">
							<xsd:selector xpath="tns:ProgramAffiliation"/>
							<xsd:field xpath="tns:AffiliatedProgramId"/>
							
							<!-- STRY0011038; Adding EffectiveDate as unique key -->
							<xsd:field xpath="tns:EffectiveDate"/>
						</xsd:unique>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderEFTEnrollment" type="tns:EFTEnrollmentList">
						<xsd:unique name="EFTEnrollmentUniqueKeyCreate">
							<xsd:selector xpath="tns:EFTEnrollment"/>
							<xsd:field xpath="tns:EFTEnrollmentId"/>
							<!-- SCTASK0033390; Removed EffectiveDate as unique key, because EFTEnrollmentId is the Unique identifier for this Node-->
						</xsd:unique>
			</xsd:element>
			
			<!--STRY0010932: OH- New provider field changes, OH new node elements-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderServices" type="tns:ProviderServicesList">
			<xsd:unique name= "ServicesUniqueKeyCreate">
					<xsd:selector xpath= "tns:Services"/>
					<xsd:field xpath= "tns:ProviderServiceID"/>
				</xsd:unique>
			</xsd:element>
			
			<!--STRY0010932: OH- New provider field changes, OH new node elements-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderCHOP" type="tns:ProviderCHOPList">
				<xsd:unique name= "CHOPUniqueKeyCreate">
					<xsd:selector xpath= "tns:CHOP"/>
					<xsd:field xpath= "tns:MedicaidProviderSellerId"/>
				</xsd:unique>
			</xsd:element>
			
			<!--STRY0010932: OH- New provider field changes, OH new node elements-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderAttestations" type="tns:ProviderAttestationsList">
			<xsd:unique name= "AttestationsUniqueKeyCreate">
					<xsd:selector xpath= "tns:Attestations"/>
					<xsd:field xpath= "tns:ProvAttestationCode"/>
					<xsd:field xpath= "tns:ProvDateSigned"/>
				</xsd:unique>
			</xsd:element>
			
			<!--STRY0010932: OH- New provider field changes, OH new node elements-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderLanguage" type="tns:ProviderLanguageList">
			<xsd:unique name= "LanguagesUniqueKeyCreate">
					<xsd:selector xpath= "tns:Languages"/>
					<xsd:field xpath= "tns:Language"/>
				</xsd:unique>
			</xsd:element>
			
			<!--STRY0010932: OH- New provider field changes, OH new node elements-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderReviews" type="tns:ProviderReviewsList">
			<xsd:unique name= "ReviewUniqueKeyCreate">
					<xsd:selector xpath= "tns:Review"/>
					<xsd:field xpath= "tns:ProviderReviewID"/>
				</xsd:unique>
			</xsd:element>
			<!--Added for HMP-3889 Changes start. Added ProviderIndicator: Start-->
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderIndicator" type="tns:ProviderIndicatorList">
					<xsd:unique name="IndicatorUniqueKeyCreate">
						<xsd:selector xpath="tns:Indicator"/>
						<xsd:field xpath="tns:IndicatorType"/>
						<xsd:field xpath="tns:EffectiveDate"/>
					</xsd:unique>
			</xsd:element>
			<!--Added for HMP-3889 Changes end. Added ProviderIndicator: End--> 
			
			<xsd:element maxOccurs="1" minOccurs="0" name="ProviderServiceLocation">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element maxOccurs="500" minOccurs="0" name="ServiceLocation" type="tns:EnrollProviderServiceLocation">
						</xsd:element>	
					</xsd:sequence>
				</xsd:complexType>
						<xsd:unique name="ServiceLocationUniqueKeyCreate">
							<xsd:selector xpath="tns:ServiceLocation"/>
							<xsd:field xpath="tns:LocationCode"/>
							
							<!-- STRY0011038; Adding EffectiveDate as unique key -->
							<xsd:field xpath="tns:EffectiveDate"/>
						</xsd:unique>
			</xsd:element>			
		</xsd:sequence>                            					         
	</xsd:complexType> 
	<xsd:complexType name="EnrollProviderDemographics">                            					         
		<xsd:sequence> 
			<xsd:element minOccurs="0" name="RecordStatusCode" type="tns:String50"/>   <!--Change by shivi-->
			<!--STRY0010946:Increasing ProviderId length from 20 to 71-->
			<xsd:element minOccurs="1" name="ProviderId" type="tns:string20"/>
			<!--HMP-2964 (HEAL-17628) changes start-->
			<xsd:element minOccurs="0" name="TaxId" type="tns:String9"/>
			<!--HMP-2964 (HEAL-17628) changes end-->
			<!--STRY0010889:XSD ODS Discrepancies fix:Start-->
			<xsd:element minOccurs="0" name="ProviderRoleCode" type="tns:String50"/>   <!--Change by shivi-->
			<!--STRY0010889:XSD ODS Discrepancies fix:End-->
			<xsd:element minOccurs="0" name="NationalProviderIdentifier" type="tns:String10"/>
			<xsd:element minOccurs="0" name="FirstName" type="tns:String40"/>
			<xsd:element minOccurs="0" name="MiddleName" type="tns:String40"/>
			<xsd:element minOccurs="0" name="LastName" type="tns:String40"/>
			<!--STRY0010932: Length increased to 15-->
			<xsd:element minOccurs="0" name="Prefix" type="tns:String15"/>   <!--Change by shivi-->
			<xsd:element minOccurs="0" name="Suffix" type="tns:String10"/>
			<!--HMP-5312:Updating Type from 'String09' to 'String9' -->
			<xsd:element minOccurs="0" name="SSN" type="tns:String09"/>
			<xsd:element minOccurs="0" name="Gender" type="tns:String50"/>
			<xsd:element minOccurs="1" name="EntityType" type="tns:string50"/>
			<xsd:element minOccurs="0" name="OrganizationBusinessName" type="tns:String100"/>
			<!--HMP-2964 (HEAL-17628) changes start-->   
			<xsd:element minOccurs="0" name="LegalProviderName" type="tns:String100"/>
			<!--HMP-2964 (HEAL-17628) changes end-->
			<xsd:element minOccurs="0" name="ProviderBusinessName" type="tns:String100"/>  <!--TMSIS field-->
			<xsd:element minOccurs="0" name="ProviderTaxName" type="tns:String100"/>  <!--TMSIS field-->
			<xsd:element minOccurs="0" name="TeachingIndicator" type="tns:String1"/>  <!--TMSIS field-->
			<xsd:element minOccurs="0" name="OwnershipCode" type="tns:String50"/>  <!--TMSIS field-->
			<!--STRY0010932: OH new elements-->
			<xsd:element minOccurs="0" name="PracticeTypeCode" type="tns:String50"/>
			<xsd:element minOccurs="0" name="ProviderProfitStatusCode" type="tns:String50"/>  <!--TMSIS field-->
			<xsd:element minOccurs="0" name="NewPatientIndicator" type="tns:String1"/>  <!--TMSIS field-->
			<!--HMP-2964 (HEAL-17628) changes start-->
			<xsd:element minOccurs="0" name="EnrollmentType" type="tns:String50"/>     <!--till here-->
			<!--HMP-2964 (HEAL-17628) changes end-->


			<xsd:element minOccurs="1" name="EffectiveDate" type="tns:MDateType"/>
			<xsd:element minOccurs="0" name="EndDate" type="tns:DateType"/>
			<xsd:element minOccurs="0" name="DateOfBirth" type="tns:DateType"/>
			<xsd:element minOccurs="0" name="DateOfDeath" type="tns:DateType"/>
			<!--HMP-2967:Adding ProviderRace-->
			<xsd:element minOccurs="0" name="Race" type="tns:String50"/>
			<!--HMP-2965 (HEAL-15764) changes start-->
			<xsd:element minOccurs="0" name="MedicareInd" type="tns:String1"/>
			<xsd:element minOccurs="0" name="PCPStatusCode" type="tns:String50"/>
			<xsd:element minOccurs="0" name="PCPTermDate" type="tns:DateType"/>
			<!--HMP-2965 (HEAL-15764) changes end-->
			<!--STRY0010932: OH new elements-->
			<xsd:element minOccurs="0" name="BirthCountry" type="tns:String50"/>
			<xsd:element minOccurs="0" name="BirthCity" type="tns:String50"/> 
			<xsd:element minOccurs="0" name="BirthState" type="tns:String50"/> 
			<xsd:element minOccurs="0" name="ProvRiskLevel" type="tns:String20"/> 
			<xsd:element minOccurs="0" name="ProvDirectorySearchIndicator" type="tns:String1"/> 
			<xsd:element minOccurs="0" name="PaymentTypeCode" type="tns:String50"/> 
			<!--STRY0010932: OH end of new elements-->
			<!-- Changed for HMP-3495 (HEAL-17380) start-->
			<xsd:element minOccurs="0" name="ProvIHSAssoCode" type="tns:String50"/>   
			<!-- Changed for HMP-3495 (HEAL-17380) end-->
			<xsd:element minOccurs="0" name="ProvDemographicsSrcKey" type="tns:String36"/>
		</xsd:sequence>                            					         
	</xsd:complexType>                           					             

	<xsd:complexType name="EnrollProviderAddress">                            					         
		<xsd:sequence>
			<xsd:element minOccurs="0" name="RecordStatusCode" type="tns:String50"/>   <!--Change by shivi-->
			<xsd:element minOccurs="1" name="AddressType" type="tns:string50"/>
			<!--HMP-2964 (HEAL-17628) changes start-->
			<!--STRY0010932: Length increased to 60-->
			<xsd:element minOccurs="0" name="AddressLine1" type="tns:String60"/>
			<!--HMP-2964 (HEAL-17628) changes end-->
			<!--STRY0010932: Length increased to 60-->
			<xsd:element minOccurs="0" name="AddressLine2" type="tns:String60"/>
