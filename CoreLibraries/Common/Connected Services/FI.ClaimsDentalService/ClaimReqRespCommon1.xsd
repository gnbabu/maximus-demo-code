          <xs:restriction base="xs:string">
            <xs:enumeration value="FFS" />
            <xs:enumeration value="MCE" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ICN">
        <xs:annotation>
          <xs:documentation>
						This is the Internal Control Number or claim
						Number should be returned in case there is
						no error
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PatientAccountNumber">
