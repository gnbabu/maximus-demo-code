  </xs:complexType>
  <xs:complexType name="ListOfRARCType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="99" name="RARC" type="tns:RARCType" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RARCType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="RARCCode">
        <xs:annotation>
          <xs:documentation>
						Remittance advise reason code
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RARCDescription">
        <xs:annotation>
          <xs:documentation>
						Description to RARC code
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="500" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ListOfDRGType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="12" name="DRG" type="tns:DRGType" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DRGType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="Sequence" type="xs:int">
        <xs:annotation>
          <xs:documentation>
						Diagnosis Sequence
					</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="CodeId">
        <xs:annotation>
          <xs:documentation>
						Diagnosis code id
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="8" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="POA">
        <xs:annotation>
          <xs:documentation>
						Present on admission
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EAPGDetailsType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="InitialEAPG">
        <xs:annotation>
          <xs:documentation>
						Final Value of the EAPG
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="5" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="FinalEAPG">
        <xs:annotation>
          <xs:documentation>
						Final Value of the EAPG
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="5" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PaymentAction">
        <xs:annotation>
          <xs:documentation>
						This is coming from Pricing Status being returned
						on the call
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="2" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ListOfClaimsXtenResultType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="100" name="ClaimsXtenResult" type="tns:ClaimsXtenResultType" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ClaimsXtenResultType">
    <xs:annotation>
      <xs:documentation>
				This is the ClaimsXtenValidation results
			</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="RelatedHistoryNumber" type="xs:int">
        <xs:annotation>
          <xs:documentation>
						The Related History (Detail) Number is the detail
						on the related claim.
					</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="AuditResult">
        <xs:annotation>
          <xs:documentation>
						The audit result is a 3-character indicator that
						is broken down as
						follows.
						Position 1: Type of lines affected by
						this audit (i.e. H = History Denied,
						C = Current denied, F =
						Flagcurrent only, R = Replace current
						only, P ??? Pay Percent)
						Position 2: Always ???-???
						Position 3: Type of other lines that caused
						or resulted from this audit
						(i.e. H = at least one history, C =
						Current only, N = New line)
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="3" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DatePosted" type="xs:date">
        <xs:annotation>
          <xs:documentation>Adjudication Date</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ErrorCode">
        <xs:annotation>
          <xs:documentation>
						This is the HPA error code (not ClaimsXten)
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="10" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ErrorDescription">
        <xs:annotation>
          <xs:documentation>
						This is the HPA error code description. This is
						not coming from Xten.
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="60" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RelatedHistoryICN">
        <xs:annotation>
          <xs:documentation>
						The ICN of the related claim
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="15" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="AuditMessage1">
        <xs:annotation>
          <xs:documentation>
						The REMIT message for the claim.
						No limit as per
						the field so limiting it to 5000
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="5000" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="AuditMessage2">
        <xs:annotation>
          <xs:documentation>
						The EOB description for the claim
						No limit as per
						the field so limiting it to 5000
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="5000" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>