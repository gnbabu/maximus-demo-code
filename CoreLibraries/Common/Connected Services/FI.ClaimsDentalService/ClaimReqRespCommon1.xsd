          <xs:documentation>
						This is the Internal Control Number or claim
						Number should be returned in case there is
						no error
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="10" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Status">
        <xs:annotation>
          <xs:documentation>
						This is the Internal Control Number or claim
						Number should be returned in case there is
						no error
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="50" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="FromDOS" type="xs:date" />
      <xs:element minOccurs="0" name="ThruDOS" type="xs:date" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EOBListType">
    <xs:annotation>
      <xs:documentation>
				This is a container for the EOB
			</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="10" name="EOB" type="tns:EOBType" />
    </xs:sequence>
  </xs:complexType>
