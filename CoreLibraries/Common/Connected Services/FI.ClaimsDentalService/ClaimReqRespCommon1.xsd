            <xs:minLength value="1" />
            <xs:maxLength value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="EditDescription">
        <xs:annotation>
          <xs:documentation>
						Description for Edit code
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="500" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ListOfCARCType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="99" name="CARC" type="tns:CARCType" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CARCType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="CARCCode">
        <xs:annotation>
          <xs:documentation>
						Claim adjustment reason code returned by payer
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CARCDescription">
        <xs:annotation>
          <xs:documentation>
						Description for CARC code
					</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="500" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="CARCAmount" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>
						Adjusted amount linked to CARC
					</xs:documentation>
        </xs:annotation>
      </xs:element>
