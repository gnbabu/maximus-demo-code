<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://mes.gov/caremanagement" elementFormDefault="qualified" targetNamespace="http://mes.gov/caremanagement" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="CareManagement_Datatypes.xsd" />
  <xs:element name="MessageHeader">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="1" name="BusinessFlow">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CreateAuthorization" />
              <xs:enumeration value="UpdateAuthorization" />
              <xs:enumeration value="InquireAuthorization" />
              <xs:enumeration value="SearchAuthorization" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" name="StateCode">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="OH" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" name="RequestorSystem">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="PNM" />
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" fixed="MITS" name="SubscriberSystem">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="MITS" />
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" name="ModuleTransactionId" type="tns:String20" />
        <xs:element minOccurs="0" name="AdditionalModuleTransactionId" type="tns:String20" />
        <xs:element minOccurs="1" name="RequestTimestamp" type="tns:MDateTimeType" />
        <xs:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Fault">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="faultcode" type="xs:string" />
        <xs:element minOccurs="0" name="faultstring" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>