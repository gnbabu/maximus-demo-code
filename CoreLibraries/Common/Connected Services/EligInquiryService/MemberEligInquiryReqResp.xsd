<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://service.membermgmt.fi/MemberEligibilityInquiryService"
	targetNamespace="http://service.membermgmt.fi/MemberEligibilityInquiryService"
	elementFormDefault="qualified">
	<xs:include schemaLocation="./CommonHeader.xsd"></xs:include>



	<xs:element name="InquireMemberEligibilityRequest">
		<xs:annotation>
			<xs:documentation>
				This element contains the request elements to
				search for an existing MemberEligibilityInquiry in FI.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MessageHeader"
					type="tns:MessageHeaderType" minOccurs="0" />
				<xs:element name="RequestPayload"
					type="tns:InquireMemberEligibilityRequestPayloadType" minOccurs="1"
					maxOccurs="1">
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType
		name="InquireMemberEligibilityRequestPayloadType">
		<xs:sequence>
			<xs:element name="MedicaidId" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Medicaid id of the recipient
					</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="0"></xs:minLength>
						<xs:maxLength value="20"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SSN" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						This is SSN of the Member to search
					</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">

						<xs:minLength value="0"></xs:minLength>
						<xs:maxLength value="9"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DateOfBirth" minOccurs="1" maxOccurs="1"
				type="xs:date">
				<xs:annotation>
					<xs:documentation>
						Date of Birth of Member
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FromDateOfService" minOccurs="1"
				maxOccurs="1" type="xs:date">
				<xs:annotation>
					<xs:documentation>
						From Date of Service to search Eligibilities
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ToDateOfService" minOccurs="1"
				maxOccurs="1" type="xs:date">
				<xs:annotation>
					<xs:documentation>
						To Date of Service to search Eligibilities
					</xs:documentation>
				</xs:annotation>
			</xs:element>

			<xs:element name="ProcedureCode" minOccurs="0"
				maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Procedure code to perform
					</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="0"></xs:minLength>
						<xs:maxLength value="20"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="InquireMemberEligibilityResponse"
		type="tns:InquireMemberEligibilityResponseType">
		<xs:annotation>
			<xs:documentation>
				This element contains the request elements to
				search for an existing MemberEligibilityInquiry in FI.
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:complexType
		name="InquireMemberEligibilityResponseType">
		<xs:sequence>
			<xs:element name="ResponseHeader" minOccurs="0"
