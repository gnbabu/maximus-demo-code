<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:ibmSchExtn="http://www.ibm.com/schema/extensions" xmlns:tns="http://mes.gov/incidentmanagement" elementFormDefault="qualified" targetNamespace="http://mes.gov/incidentmanagement" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="IncidentManagement_InlineSchema.xsd" />
  <xsd:include schemaLocation="IncidentManagement_MessageHeader.xsd" />
  <xsd:element ibmSchExtn:docRoot="true" name="SendProviderIncidentRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="1" ref="tns:MessageHeader" />
        <xsd:element name="Payload">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="SendProviderIncidentInfo" type="tns:SendProviderIncidentRequest" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element ibmSchExtn:docRoot="true" name="SendProviderIncidentResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xsd:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xsd:element minOccurs="0" name="AdditionalModuleTransactionId" type="tns:String50" />
        <xsd:element minOccurs="0" name="ResponseCode" type="xsd:string" />
        <xsd:element minOccurs="0" name="ResponseType">
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:enumeration value="Success" />
              <xsd:enumeration value="Failure" />
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element minOccurs="0" name="ResponseMessage" type="xsd:string" />
        <xsd:element minOccurs="0" name="ResponseDetails" type="xsd:string" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element ibmSchExtn:docRoot="true" name="UpdateProviderIncidentStatusRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="1" ref="tns:MessageHeader" />
        <xsd:element name="Payload">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="UpdateProviderIncidentStatusInfo" type="tns:UpdateProviderIncidentStatusInfo" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element ibmSchExtn:docRoot="true" name="UpdateProviderIncidentStatusResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xsd:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xsd:element minOccurs="0" name="AdditionalModuleTransactionId" type="tns:String50" />
        <xsd:element minOccurs="0" name="ResponseCode" type="xsd:string" />
        <xsd:element minOccurs="0" name="ResponseType" type="xsd:string" />
        <xsd:element minOccurs="0" name="ResponseMessage" type="xsd:string" />
        <xsd:element minOccurs="0" name="ResponseDetails" type="xsd:string" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>