<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://ohio.gov/SearchResponses" attributeFormDefault="unqualified" elementFormDefault="unqualified" targetNamespace="http://ohio.gov/SearchResponses" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
			This document contains the elements to search for existing Hospice applications in MITS. 
		</xs:documentation>
  </xs:annotation>
  <xs:element name="SearchResponses">
    <xs:annotation>
      <xs:documentation>
				This element contains the response elements.
			</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="Response">
          <xs:annotation>
            <xs:documentation>
						This element contains the response elements.
					</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="HospiceTrackNo" type="xs:int" />
              <xs:element name="RecipID" type="xs:string" />
              <xs:element name="RecipName" type="xs:string" />
              <xs:element name="RecipBirthDate" type="xs:date" />
              <xs:element name="ElectionDate" type="xs:date" />
              <xs:element name="SubmissionDate" type="xs:date" />
              <xs:element name="BenPeriodEffDate" type="xs:date" />
              <xs:element name="BenPeriodEndDate" type="xs:date" />
              <xs:element name="Status" type="str1" />
              <xs:element name="DenialReason" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="Errors">
          <xs:annotation>
            <xs:documentation>
								This element contains the error response 
						</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ErrorCode" type="xs:string" />
              <xs:element name="SevCode" type="xs:string" />
              <xs:element name="ErrorDesc" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="str1">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>