<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://ohio.gov/SearchRequest" attributeFormDefault="unqualified" elementFormDefault="unqualified" targetNamespace="http://ohio.gov/SearchRequest" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
			This document contains the elements to search for existing Hospice applications in MITS. 
		</xs:documentation>
  </xs:annotation>
  <xs:element name="SearchRequest">
    <xs:annotation>
      <xs:documentation>
				This element contains the request elements to to search for existing Hospice applications in MITS.
			</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="HospiceTrackNo" type="xs:int" />
        <xs:element minOccurs="0" name="RecipID" type="xs:string" />
        <xs:element name="ProvMedID" type="xs:string" />
        <xs:element minOccurs="0" name="ProvNPI" type="xs:string" />
        <xs:element minOccurs="0" default="1" name="Offset" type="xs:int" />
        <xs:element minOccurs="0" name="Count" type="xs:int" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>