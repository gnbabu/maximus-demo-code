<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://mes.gov/incidentmanagement" xmlns:tns="http://mes.gov/incidentmanagement">
	<xs:include schemaLocation="IncidentManagement_Datatypes.xsd"/>
	<xs:element name="MessageHeader">
		<xs:complexType>                          					         
			<xs:sequence>
				<xs:element name="BusinessFlow" minOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">						
							<xs:enumeration value="SendProviderIncident"/>
						    <xs:enumeration value="UpdateProviderIncidentStatus"/>	
							<xs:minLength value="1"/>
							<xs:maxLength value="50"/>							
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="1" name="StateCode" >
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[A|a][L|l]|[A|a][K|k]|[A|a][Z|z]|[A|a][R|r]|[C|c][A|a]|[C|c][O|o]|[C|c][T|t]|[D|d][E|e]|[F|f][L|l]|[G|g][A|a]|[H|h][I|i]|[I|i][D|d]|[I|i][L|l]|[I|i][N|n]|[I|i][A|a]|[K|k][S|s]|[K|k][Y|y]|[L|l][A|a]|[M|m][E|e]|[M|m][D|d]|[M|m][A|a]|[M|m][I|i]|[M|m][N|n]|[M|m][S|s]|[M|m][O|o]|[M|m][T|t]|[N|n][E|e]|[N|n][V|v]|[N|n][H|h]|[N|n][J|j]|[N|n][M|m]|[N|n][Y|y]|[N|n][C|c]|[N|n][D|d]|[O|o][H|h]|[O|o][K|k]|[O|o][R|r]|[P|p][A|a]|[R|r][I|i]|[S|s][C|c]|[S|s][D|d]|[T|t][N|n]|[T|t][X|x]|[U|u][T|t]|[V|v][T|t]|[V|v][A|a]|[W|w][A|a]|[W|w][V|v]|[W|w][I|i]|[W|w][Y|y]"/>
					</xs:restriction>
				</xs:simpleType>
			    </xs:element>
				<xs:element minOccurs="1" name="RequestorSystem">
                     <xs:simpleType>
						<xs:restriction base="xs:string">
                            <xs:enumeration value="PNM"/>
						    <xs:enumeration value="IMS"/>
							<xs:enumeration value="HealthCheck"/>							
						</xs:restriction>
					</xs:simpleType>
                </xs:element>
				<!-- HMP-4088: Start of changes -->	
				<xs:element name="SubscriberSystem" minOccurs="1" maxOccurs="1">
					<xs:complexType >                           					         
						<xs:sequence>
							<xs:element name="Subscriber" minOccurs="1" maxOccurs="10">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="PNM"/>
										<xs:enumeration value="IMS"/>
										<xs:minLength value="1"/>
										<xs:maxLength value="50"/>	
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>                            					         
					</xs:complexType>
				</xs:element>	
				<!-- HMP-4088: End of changes -->
				<xs:element name="ModuleTransactionId" type="tns:String50" minOccurs="0"/>
                <xs:element name="AdditionalModuleTransactionId" type="tns:String50" minOccurs="0"/>
				<xs:element name="RequestTimestamp" type="tns:MDateTimeType" minOccurs="1"/>
				<xs:element name="SITransactionKey" type="tns:String32" minOccurs="0"/> 
			</xs:sequence>                            					         
		</xs:complexType>   
	</xs:element>		
	
	<xs:element name="Fault">
		<xs:complexType>                            					         
			<xs:sequence>
				<xs:element name="faultcode" type="xs:string" minOccurs="0"/>
				<xs:element name="faultstring" type="xs:string" minOccurs="0"/>
			</xs:sequence>                            					         
		</xs:complexType>                           					             
	</xs:element>			
</xs:schema>