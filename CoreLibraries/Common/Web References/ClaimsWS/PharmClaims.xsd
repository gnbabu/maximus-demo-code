                          </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="cde_ndc_sub">
                          <xs:simpleType>
                            <xs:restriction base="xs:string">
                              <xs:maxLength value="11" />
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="qty_dispense_sub">
