<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://mes.gov/caremanagement" elementFormDefault="qualified" targetNamespace="http://mes.gov/caremanagement" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="CareManagement_InlineSchema.xsd" />
  <xs:include schemaLocation="CareManagement_MessageHeader.xsd" />
  <xs:element name="CreateAuthorization">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tns:MessageHeader" />
        <xs:element name="Payload" type="tns:CreateRequestPayload" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="CreateAuthorizationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xs:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xs:element minOccurs="0" name="ResponseCode" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseType" type="xs:string" />
        <xs:element minOccurs="0" name="ODSPriorAuthorizationID" type="xs:integer" />
        <xs:element minOccurs="0" name="ResponseMessage" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseDetails" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="UpdateAuthorization">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tns:MessageHeader" />
        <xs:element name="Payload" type="tns:UpdateRequestPayload" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="UpdateAuthorizationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xs:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xs:element minOccurs="0" name="ResponseCode" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseType" type="xs:string" />
        <xs:element minOccurs="0" name="ODSPriorAuthorizationID" type="xs:integer" />
        <xs:element minOccurs="0" name="ResponseMessage" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseDetails" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SearchAuthorizationRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tns:MessageHeader" />
        <xs:element minOccurs="1" maxOccurs="1" ref="tns:SearchAuthorizationPayload" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SearchAuthorizationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xs:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xs:element minOccurs="0" name="ResponseCode" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseType" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseMessage" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseDetails" type="xs:string" />
        <xs:element minOccurs="1" maxOccurs="500" ref="tns:ResponsePayload" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="InquireAuthorizationRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tns:MessageHeader" />
        <xs:element minOccurs="1" maxOccurs="1" ref="tns:InquireAuthorizationPayload" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="InquireAuthorizationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="SITransactionKey" type="tns:String32" />
        <xs:element minOccurs="0" name="ModuleTransactionId" type="tns:String50" />
        <xs:element minOccurs="0" name="ResponseCode" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseType" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseMessage" type="xs:string" />
        <xs:element minOccurs="0" name="ResponseDetails" type="xs:string" />
        <xs:element name="ResponsePayload">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" maxOccurs="500" name="AuthorizationInformation" type="tns:InquireAuthorizationInformation" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>